    {
      "id": "p04",
      "title": "替换 FFN",
      "illustration": "ffn-swap",
      "beats": [
        {
          "id": "p04-b01",
          "text": "做法很简单：把每个 FFN 换成 E 个独立专家。"
        },
        {
          "id": "p04-b02",
          "text": "再加一个路由器，为每个 token 挑 k 个专家。"
        },
        {
          "id": "p04-b03",
          "text": "总参数随 E 涨，算力只随 k 涨。"
        }
      ],
      "visual_groups": [
        {
          "start_beat": 0,
          "end_beat": 2,
