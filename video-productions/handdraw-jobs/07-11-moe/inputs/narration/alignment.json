{
  "version": 1,
  "source_sha256": "03aa239bb4280dafb5442a0ff88135173ab5279161d2c4a047de604d8ad69cf3",
  "script_sha256": "283f4538c16c04c25a75df203d3195134ca9d3ea3d140f3004f0cd76e0129317",
  "beats": [
    {
      "id": "p01-b01",
      "text": "一个稠密模型，每个 token 都要跑完所有参数。",
      "start": 0.0,
      "end": 4.152
    },
    {
      "id": "p01-b02",
      "text": "但有个办法，让 6710 亿参数的模型每个 token 只算 370 亿。",
      "start": 4.36,
      "end": 10.732
    },
    {
      "id": "p01-b03",
      "text": "它就是混合专家。",
      "start": 10.96,
      "end": 12.674
    },
    {
      "id": "p02-b01",
      "text": "阶段 7，第 11 课：Mixture of Experts。",
      "start": 12.96,
      "end": 16.855
    },
    {
      "id": "p02-b02",
      "text": "2026 年的前沿模型几乎全是 MoE。",
      "start": 17.04,
      "end": 20.68
    },
    {
      "id": "p02-b03",
      "text": "稀疏，是这十年最重要的扩展思路。",
      "start": 20.68,
      "end": 24.077
    },
    {
      "id": "p03-b01",
      "text": "稠密 transformer 的推理算力，等于参数量乘二。",
      "start": 24.32,
      "end": 28.467
    },
    {
      "id": "p03-b02",
      "text": "把模型做大，每个 token 就付全额账单。",
      "start": 28.64,
      "end": 32.418
    },
    {
      "id": "p03-b03",
      "text": "到 2024 年，前沿撞上了这堵墙。",
      "start": 32.64,
      "end": 36.057
    },
    {
      "id": "p04-b01",
      "text": "做法很简单：把每个 FFN 换成 E 个独立专家。",
      "start": 36.32,
      "end": 40.867
    },
    {
      "id": "p04-b02",
      "text": "再加一个路由器，为每个 token 挑 k 个专家。",
      "start": 41.12,
      "end": 44.996
    },
    {
      "id": "p04-b03",
      "text": "总参数随 E 涨，算力只随 k 涨。",
      "start": 45.2,
      "end": 48.28
    },
    {
      "id": "p05-b01",
      "text": "路由器就是一个线性层，给每个 token 对每个专家打分。",
      "start": 48.56,
      "end": 53.629
    },
    {
      "id": "p05-b02",
      "text": "取分数最高的 k 个，就是被激活的专家。",
      "start": 53.84,
      "end": 57.515
    },
    {
      "id": "p05-b03",
      "text": "DeepSeek V3 的配置是 256 个专家，每个 token 选 8 个。",
      "start": 57.76,
      "end": 63.096
    },
    {
      "id": "p06-b01",
      "text": "选中的专家各算一遍，输出按门控权重加权求和。",
      "start": 63.28,
      "end": 68.22
    },
    {
      "id": "p06-b02",
      "text": "门控权重是原始分数的 softmax，不是加偏置之后的。",
      "start": 68.48,
      "end": 73.626
    },
    {
      "id": "p06-b03",
      "text": "这一点很关键，讲均衡时会用到。",
      "start": 73.84,
      "end": 76.942
    },
    {
      "id": "p07-b01",
      "text": "如果路由器把九成 token 都送进专家 3，其他专家就饿死了。",
      "start": 77.2,
      "end": 82.747
    },
    {
      "id": "p07-b02",
      "text": "早期用辅助损失罚使用率方差，多一个超参和第二个梯度信号。",
      "start": 82.96,
      "end": 88.806
    },
    {
      "id": "p07-b03",
      "text": "Switch Transformer 还用容量丢弃，溢出的 token 直接跳过这一层。",
      "start": 89.04,
      "end": 94.571
    },
    {
      "id": "p08-b01",
      "text": "DeepSeek V3 换了个思路：给每个专家加一个学到的偏置。",
      "start": 94.72,
      "end": 99.657
    },
    {
      "id": "p08-b02",
      "text": "偏置只影响选择，不影响门控权重。",
      "start": 99.84,
      "end": 103.183
    },
    {
      "id": "p08-b03",
      "text": "每步训练后按使用率推正负，把路由和表达解耦了。",
      "start": 103.44,
      "end": 108.392
    },
    {
      "id": "p09-b01",
      "text": "跑一千个 token，目标是每个专家二百五十个。",
      "start": 108.64,
      "end": 112.82
    },
    {
      "id": "p09-b02",
      "text": "不加偏置时，使用率在两百零六到三百零一之间乱跳。",
      "start": 113.04,
      "end": 118.194
    },
    {
      "id": "p09-b03",
      "text": "加偏置更新后，熵逼近 2.079，也就是 ln8，几乎完全均匀。",
      "start": 118.48,
      "end": 124.931
    },
    {
      "id": "p10-b01",
      "text": "经典 MoE 的专家和完整 FFN 一样宽，E 小 k 也小。",
      "start": 125.2,
      "end": 129.953
    },
    {
      "id": "p10-b02",
      "text": "现代做法把专家切细：每个只有八分之一宽。",
      "start": 130.16,
      "end": 134.391
    },
    {
      "id": "p10-b03",
      "text": "256 选 8，组合数是四百万亿种，质量上去延迟不动。",
      "start": 134.64,
      "end": 140.379
    },
    {
      "id": "p11-b01",
      "text": "DeepSeek V3 是 6710 亿总参数，每个 token 激活 370 亿。",
      "start": 140.64,
      "end": 146.918
    },
    {
      "id": "p11-b02",
      "text": "Llama 3 70B 是 700 亿稠密，全部激活，V3 却几乎在每个基准上赢它。",
      "start": 147.12,
      "end": 154.018
    },
    {
      "id": "p11-b03",
      "text": "但所有专家都活在 GPU 上，1.3 TB 显存，必须做专家并行。",
      "start": 154.24,
      "end": 160.461
    },
    {
      "id": "p12-b01",
      "text": "如果你只有 8 张卡，你会选稠密还是 MoE？",
      "start": 160.72,
      "end": 164.395
    },
    {
      "id": "p12-b02",
      "text": "评论区说说你的取舍：显存优先还是延迟优先。",
      "start": 164.64,
      "end": 169.187
    },
    {
      "id": "p12-b03",
      "text": "关注这个系列，下一集讲位置编码怎么外推。",
      "start": 169.44,
      "end": 173.596
    }
  ]
}