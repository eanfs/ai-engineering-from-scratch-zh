		{
			"timestamps": {
				"from": "00:02:34,240",
				"to": "00:02:40,720"
			},
			"offsets": {
				"from": 154240,
				"to": 160720
			},
			"text": "但所有专家都活在GPU上,1.3tb显存,必须做专家并行。"
