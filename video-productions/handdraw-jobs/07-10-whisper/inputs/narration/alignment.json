{
  "version": 1,
  "source_sha256": "fb8cdcf62fb08ae16cc366df865185264ba09881a1f2245513ddd9fcf1d522c9",
  "script_sha256": "852e7bbf34d939fd0297b797dc1368da8d06520dd5fa8a73f21efc48ad1a8c26",
  "beats": [
    {
      "id": "p01-b01",
      "text": "一段语音，为什么能被当成图像来读？",
      "start": 0.0,
      "end": 3.267
    },
    {
      "id": "p01-b02",
      "text": "把它变成频率随时间的谱图，就成了二维输入。",
      "start": 3.5,
      "end": 7.574
    },
    {
      "id": "p01-b03",
      "text": "Whisper 就是这么干的。",
      "start": 7.8,
      "end": 10.015
    },
    {
      "id": "p02-b01",
      "text": "阶段 7，第 10 课：音频 Transformer 与 Whisper。",
      "start": 10.2,
      "end": 14.63
    },
    {
      "id": "p02-b02",
      "text": "它吃一张 mel 频谱图，再开口说回来。",
      "start": 14.8,
      "end": 18.094
    },
    {
      "id": "p02-b03",
      "text": "一个编码器-解码器，没有声码器，也没有 CTC。",
      "start": 18.3,
      "end": 22.847
    },
    {
      "id": "p03-b01",
      "text": "Whisper 下了三个赌：什么都拿来训、多任务单模型、标准 transformer。",
      "start": 23.1,
      "end": 29.132
    },
    {
      "id": "p03-b02",
      "text": "68 万小时弱标注音频，横跨 97 种语言。",
      "start": 29.3,
      "end": 33.818
    },
    {
      "id": "p03-b03",
      "text": "结果是对口音和噪声都很鲁棒。",
      "start": 34.1,
      "end": 37.331
    },
    {
      "id": "p04-b01",
      "text": "16 kHz 音频，裁剪或填充到 30 秒。",
      "start": 37.6,
      "end": 41.756
    },
    {
      "id": "p04-b02",
      "text": "算 80 个 mel bin、10 毫秒步长的 log-mel 频谱图。",
      "start": 42.0,
      "end": 46.345
    },
    {
      "id": "p04-b03",
      "text": "得到约 3000 帧，这就是 Whisper 看到的输入图像。",
      "start": 46.5,
      "end": 51.108
    },
    {
      "id": "p05-b01",
      "text": "两个卷积核为 3、步长为 2 的卷积层。",
      "start": 51.3,
      "end": 54.847
    },
    {
      "id": "p05-b02",
      "text": "把 3000 帧降到 1500，参数量增加很少。",
      "start": 55.1,
      "end": 59.174
    },
    {
      "id": "p05-b03",
      "text": "这是整个模型里唯一的卷积。",
      "start": 59.4,
      "end": 62.242
    },
    {
      "id": "p06-b01",
      "text": "1500 个时间步进 24 层 transformer 编码器。",
      "start": 62.5,
      "end": 67.115
    },
    {
      "id": "p06-b02",
      "text": "正弦位置编码、自注意力、GELU 前馈。",
      "start": 67.3,
      "end": 71.519
    },
    {
      "id": "p06-b03",
      "text": "输出 1500 乘 1280 的隐藏状态。",
      "start": 71.8,
      "end": 75.737
    },
    {
      "id": "p07-b01",
      "text": "解码器从 BPE 词表自回归地产出文本。",
      "start": 76.0,
      "end": 80.047
    },
    {
      "id": "p07-b02",
      "text": "开头几个特殊 token 决定任务：语言、转写还是翻译。",
      "start": 80.3,
      "end": 85.37
    },
    {
      "id": "p07-b03",
      "text": "这就是语音版的指令微调，一条四 token 前缀。",
      "start": 85.6,
      "end": 89.695
    },
    {
      "id": "p08-b01",
      "text": "beam search 宽度是 5，带 log 概率阈值。",
      "start": 89.695,
      "end": 93.535
    },
    {
      "id": "p08-b02",
      "text": "每 0.02 秒预测一个时间戳。",
      "start": 93.7,
      "end": 96.633
    },
    {
      "id": "p08-b03",
      "text": "输出就是带时间的转写文本。",
      "start": 96.9,
      "end": 99.65
    },
    {
      "id": "p09-b01",
      "text": "从 tiny 的 3900 万到 large-v3 的 15 亿，一共六档。",
      "start": 99.9,
      "end": 104.907
    },
    {
      "id": "p09-b02",
      "text": "turbo 把解码器从 32 层砍到 4 层，解码快 8 倍。",
      "start": 105.1,
      "end": 109.968
    },
    {
      "id": "p09-b03",
      "text": "代价是词错误率回退不到一个点，这是实时语音的关键。",
      "start": 110.2,
      "end": 115.461
    },
    {
      "id": "p10-b01",
      "text": "如果你要做实时语音助手，你会选哪一档？",
      "start": 115.7,
      "end": 119.276
    },
    {
      "id": "p10-b02",
      "text": "评论区说说你的取舍：延迟优先还是准确率优先。",
      "start": 119.5,
      "end": 124.25
    },
    {
      "id": "p10-b03",
      "text": "关注这个系列，下一集讲 MoE，参数和计算量怎么解耦。",
      "start": 124.5,
      "end": 129.738
    }
  ]
}