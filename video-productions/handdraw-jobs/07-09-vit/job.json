      "illustration": "cnn-era",
      "beats": [
        {
          "id": "p03-b01",
          "text": "ImageNet、COCO、检测基准，每个 SOTA 都用 CNN 骨干。"
        },
        {
          "id": "p03-b02",
          "text": "transformer 当时是给语言用的，没人觉得它适合图像。"
        },
        {
          "id": "p03-b03",
          "text": "Dosovitskiy 等人 2020 年的论文打破了这个假设。"
        }
      ],
      "visual_groups": [
        {
          "start_beat": 0,
          "end_beat": 2,
