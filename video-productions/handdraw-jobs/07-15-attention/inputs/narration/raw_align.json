	"transcription": [
		{
			"timestamps": {
				"from": "00:00:00,000",
				"to": "00:00:04,100"
			},
			"offsets": {
				"from": 0,
				"to": 4100
			},
			"text": "完整的注意力,每个词都要看前面所有的词。"
		},
		{
			"timestamps": {
				"from": "00:00:04,100",
				"to": "00:00:06,000"
			},
			"offsets": {
				"from": 4100,
				"to": 6000
			},
			"text": "但真的有必要吗?"
		},
		{
			"timestamps": {
				"from": "00:00:06,000",
				"to": "00:00:09,600"
			},
			"offsets": {
				"from": 6000,
				"to": 9600
			},
			"text": "如果只看附近几个词,效果会差多少?"
		},
		{
			"timestamps": {
				"from": "00:00:09,600",
				"to": "00:00:13,300"
			},
			"offsets": {
				"from": 9600,
				"to": 13300
			},
			"text": "阶段期,第15课,注意力变体。"
		},
		{
			"timestamps": {
				"from": "00:00:13,300",
				"to": "00:00:18,100"
			},
			"offsets": {
				"from": 13300,
				"to": 18100
			},
			"text": "完整注意力,在序列长度上要平方的显存和算理。"
		},
		{
			"timestamps": {
				"from": "00:00:18,100",
				"to": "00:00:21,400"
			},
			"offsets": {
				"from": 18100,
				"to": 21400
			},
			"text": "四种变体,把成本砍掉一半以上。"
		},
		{
			"timestamps": {
				"from": "00:00:21,400",
				"to": "00:00:27,500"
			},
			"offsets": {
				"from": 21400,
				"to": 27500
			},
			"text": "128000上下文的70亿模型,每层有160亿个注意力条目。"
		},
		{
			"timestamps": {
				"from": "00:00:27,500",
				"to": "00:00:32,100"
			},
			"offsets": {
				"from": 27500,
				"to": 32100
			},
			"text": "在乘以80层,这个数字就没法装进显存了。"
		},
		{
			"timestamps": {
				"from": "00:00:32,100",
				"to": "00:00:36,800"
			},
			"offsets": {
				"from": 32100,
				"to": 36800
			},
			"text": "Flash Tension藏掉了激活显存,但没改算数成本。"
		},
		{
			"timestamps": {
				"from": "00:00:36,800",
				"to": "00:00:41,500"
			},
			"offsets": {
				"from": 36800,
				"to": 41500
			},
			"text": "第一种变体,每个词只看前面固定窗口内的词。"
		},
		{
			"timestamps": {
				"from": "00:00:41,500",
				"to": "00:00:45,700"
			},
			"offsets": {
				"from": 41500,
				"to": 45700
			},
			"text": "窗口外的位置直接是负无穷,不参与计算。"
		},
		{
			"timestamps": {
				"from": "00:00:45,700",
				"to": "00:00:50,700"
			},
			"offsets": {
				"from": 45700,
				"to": 50700
			},
			"text": "序列8000,窗口1024,非零行少了8倍。"
		},
		{
			"timestamps": {
				"from": "00:00:50,700",
				"to": "00:00:54,700"
			},
			"offsets": {
				"from": 50700,
				"to": 54700
			},
			"text": "滑动窗口最大的好处是KV缓存变小。"
		},
		{
			"timestamps": {
				"from": "00:00:54,700",
				"to": "00:00:58,700"
			},
			"offsets": {
				"from": 54700,
				"to": 58700
			},
			"text": "每层只要保留最后窗口那么多个词的KV。"
		},
		{
			"timestamps": {
				"from": "00:00:58,700",
				"to": "00:01:09,700"
			},
			"offsets": {
				"from": 58700,
				"to": 69700
			},
			"text": "实测,70亿模型128000上下文,完整要42.9G,窗口1024只要0.3G,降了128倍。"
		},
		{
			"timestamps": {
				"from": "00:01:09,700",
				"to": "00:01:14,900"
			},
			"offsets": {
				"from": 69700,
				"to": 74900
			},
			"text": "问题是,纯滑动窗口在长距离检索上会很吃力。"
		},
		{
			"timestamps": {
				"from": "00:01:14,900",
				"to": "00:01:20,400"
			},
			"offsets": {
				"from": 74900,
				"to": 80400
			},
			"text": "它看不到很远的上下文,信息只能靠层层重叠往前传。"
		},
		{
			"timestamps": {
				"from": "00:01:20,400",
				"to": "00:01:23,500"
			},
			"offsets": {
				"from": 80400,
				"to": 83500
			},
			"text": "所以,实际模型用混合结构。"
		},
		{
			"timestamps": {
				"from": "00:01:23,500",
				"to": "00:01:28,800"
			},
			"offsets": {
				"from": 83500,
				"to": 88800
			},
			"text": "Gemma3的做法是,五层滑动窗口,配一层全局注意力。"
		},
		{
			"timestamps": {
				"from": "00:01:28,800",
				"to": "00:01:33,200"
			},
			"offsets": {
				"from": 88800,
				"to": 93200
			},
			"text": "这样机身显存,又保留了跨长距离的检索能力。"
		},
		{
			"timestamps": {
				"from": "00:01:33,200",
				"to": "00:01:39,300"
			},
			"offsets": {
				"from": 93200,
				"to": 99300
			},
			"text": "实测,混合结构KV缓存7.4G,是完整的5.8分之一。"
		},
		{
			"timestamps": {
				"from": "00:01:39,300",
				"to": "00:01:43,700"
			},
			"offsets": {
				"from": 99300,
				"to": 103700
			},
			"text": "第二种便体,预先设计一个稀疏的注意力模式。"
		},
		{
			"timestamps": {
				"from": "00:01:43,700",
				"to": "00:01:49,200"
			},
			"offsets": {
				"from": 103700,
				"to": 109200
			},
			"text": "比如,只看最近的1000个词,加上之前每个固定不长的词。"
		},
		{
			"timestamps": {
				"from": "00:01:49,200",
				"to": "00:01:54,700"
			},
			"offsets": {
				"from": 109200,
				"to": 114700
			},
			"text": "这样就同时抓住了局部和长城,算力降到N的1.5次方。"
		},
		{
			"timestamps": {
				"from": "00:01:54,700",
				"to": "00:01:58,400"
			},
			"offsets": {
				"from": 114700,
				"to": 118400
			},
			"text": "第三种便体,解决的是,另一个怪现象。"
		},
		{
			"timestamps": {
				"from": "00:01:58,400",
				"to": "00:02:04,300"
			},
			"offsets": {
				"from": 118400,
				"to": 124300
			},
			"text": "模型总是把大量注意力权,重分给第一个词,哪怕它毫无意义。"
		},
		{
			"timestamps": {
				"from": "00:02:04,300",
				"to": "00:02:07,200"
			},
			"offsets": {
				"from": 124300,
				"to": 127200
			},
			"text": "这叫注意力汇,是一种浪费。"
		},
		{
			"timestamps": {
				"from": "00:02:07,200",
				"to": "00:02:12,000"
			},
			"offsets": {
				"from": 127200,
				"to": 132000
			},
			"text": "差分注意力的做法,是算两张注意力图,然后相减。"
		},
		{
			"timestamps": {
				"from": "00:02:12,000",
				"to": "00:02:16,200"
			},
			"offsets": {
				"from": 132000,
				"to": 136200
			},
			"text": "一张减另一张,正好把汇点那个成分抵消掉。"
		},
		{
			"timestamps": {
				"from": "00:02:16,200",
				"to": "00:02:23,200"
			},
			"offsets": {
				"from": 136200,
				"to": 143200
			},
			"text": "实测,汇聚权重从0.335降到0.169,注意力分配更干净。"
		},
		{
			"timestamps": {
				"from": "00:02:23,200",
				"to": "00:02:27,900"
			},
			"offsets": {
				"from": 143200,
				"to": 147900
			},
			"text": "把四种方案放一起对比,滑动窗口是最便宜的。"
		},
		{
			"timestamps": {
				"from": "00:02:27,900",
				"to": "00:02:32,700"
			},
			"offsets": {
				"from": 147900,
				"to": 152700
			},
			"text": "纯滑动窗口降128倍,混合方案降6倍。"
		},
		{
			"timestamps": {
				"from": "00:02:32,700",
				"to": "00:02:37,700"
			},
			"offsets": {
				"from": 152700,
				"to": 157700
			},
			"text": "差分注意力,反而要付两倍的缓存,换来无汇的检索。"
		},
		{
			"timestamps": {
				"from": "00:02:37,700",
				"to": "00:02:42,700"
			},
			"offsets": {
				"from": 157700,
				"to": 162700
			},
			"text": "如果你要做一个超长文档检索的产品,你会选哪种注意力?"
		},
		{
			"timestamps": {
				"from": "00:02:42,700",
				"to": "00:02:47,700"
			},
			"offsets": {
				"from": 162700,
				"to": 167700
			},
			"text": "评论区说说,纯滑动窗口,混合,还是差分。"
		},
		{
			"timestamps": {
				"from": "00:02:47,700",
				"to": "00:02:51,700"
			},
			"offsets": {
				"from": 167700,
				"to": 171700
			},
			"text": "关注这个系列,下一集讲投机结码。"
		}
	]
}
