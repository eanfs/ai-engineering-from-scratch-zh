{
  "version": 1,
  "source_sha256": "c22b23a614fb235a4b30774ac635f6c7f69cf3b76627669d9ba0d45fa7a60e62",
  "script_sha256": "4506870724dd85cc2c9863e5c6f1ceb975179416b1706e035ac8c9d7136ad5a3",
  "beats": [
    {
      "id": "p01-b01",
      "text": "完整的注意力，每个词都要看前面所有的词。",
      "start": 0.0,
      "end": 3.872
    },
    {
      "id": "p01-b02",
      "text": "但真的有必要吗？",
      "start": 4.1,
      "end": 5.729
    },
    {
      "id": "p01-b03",
      "text": "如果只看附近几个词，效果会差多少？",
      "start": 6.0,
      "end": 9.36
    },
    {
      "id": "p02-b01",
      "text": "阶段 7，第 15 课：注意力变体。",
      "start": 9.6,
      "end": 12.992
    },
    {
      "id": "p02-b02",
      "text": "完整注意力在序列长度上要平方的显存和算力。",
      "start": 13.3,
      "end": 17.86
    },
    {
      "id": "p02-b03",
      "text": "四种变体把成本砍掉一半以上。",
      "start": 18.1,
      "end": 21.146
    },
    {
      "id": "p03-b01",
      "text": "十二万八千上下文的七十亿模型，每层有一百六十亿个注意力条目。",
      "start": 21.4,
      "end": 27.282
    },
    {
      "id": "p03-b02",
      "text": "再乘以八十层，这个数字就没法装进显存了。",
      "start": 27.5,
      "end": 31.844
    },
    {
      "id": "p03-b03",
      "text": "Flash Attention 藏掉了激活显存，但没改算术成本。",
      "start": 32.1,
      "end": 36.619
    },
    {
      "id": "p04-b01",
      "text": "第一种变体：每个词只看前面固定窗口内的词。",
      "start": 36.8,
      "end": 41.253
    },
    {
      "id": "p04-b02",
      "text": "窗口外的位置直接是负无穷，不参与计算。",
      "start": 41.5,
      "end": 45.453
    },
    {
      "id": "p04-b03",
      "text": "序列八千、窗口一千零二十四，非零行少了八倍。",
      "start": 45.7,
      "end": 50.437
    },
    {
      "id": "p05-b01",
      "text": "滑动窗口最大的好处是 KV 缓存变小。",
      "start": 50.7,
      "end": 54.45
    },
    {
      "id": "p05-b02",
      "text": "每层只要保留最后窗口那么多个词的 KV。",
      "start": 54.7,
      "end": 58.478
    },
    {
      "id": "p05-b03",
      "text": "实测：七十亿模型十二万八千上下文，完整要 42.9 GB，窗口一千零二十四只要 0.3 GB，降了 128 倍。",
      "start": 58.7,
      "end": 69.425
    },
    {
      "id": "p06-b01",
      "text": "问题是，纯滑动窗口在长距离检索上会很吃力。",
      "start": 69.7,
      "end": 74.626
    },
    {
      "id": "p06-b02",
      "text": "它看不到很远的上下文，信息只能靠层层重叠往前传。",
      "start": 74.9,
      "end": 80.15
    },
    {
      "id": "p06-b03",
      "text": "所以实际模型用混合结构。",
      "start": 80.4,
      "end": 83.218
    },
    {
      "id": "p07-b01",
      "text": "Gemma 3 的做法是：五层滑动窗口，配一层全局注意力。",
      "start": 83.5,
      "end": 88.579
    },
    {
      "id": "p07-b02",
      "text": "这样既省显存，又保留了跨长距离的检索能力。",
      "start": 88.8,
      "end": 92.968
    },
    {
      "id": "p07-b03",
      "text": "实测：混合结构 KV 缓存 7.4 GB，是完整的五点八分之一。",
      "start": 93.2,
      "end": 99.023
    },
    {
      "id": "p08-b01",
      "text": "第二种变体：预先设计一个稀疏的注意力模式。",
      "start": 99.3,
      "end": 103.468
    },
    {
      "id": "p08-b02",
      "text": "比如只看最近的一千个词，加上之前每隔固定步长的词。",
      "start": 103.7,
      "end": 108.98
    },
    {
      "id": "p08-b03",
      "text": "这样就同时抓住了局部和长程，算力降到 N 的 1.5 次方。",
      "start": 109.2,
      "end": 114.461
    },
    {
      "id": "p09-b01",
      "text": "第三种变体解决的是另一个怪现象。",
      "start": 114.7,
      "end": 118.153
    },
    {
      "id": "p09-b02",
      "text": "模型总是把大量注意力权重分给第一个词，哪怕它毫无意义。",
      "start": 118.4,
      "end": 124.064
    },
    {
      "id": "p09-b03",
      "text": "这叫注意力汇，是一种浪费。",
      "start": 124.3,
      "end": 126.936
    },
    {
      "id": "p10-b01",
      "text": "差分注意力的做法是算两张注意力图，然后相减。",
      "start": 127.2,
      "end": 131.76
    },
    {
      "id": "p10-b02",
      "text": "一张减另一张，正好把汇点那个成分抵消掉。",
      "start": 132.0,
      "end": 135.967
    },
    {
      "id": "p10-b03",
      "text": "实测：汇聚权重从 0.335 降到 0.169，注意力分配更干净。",
      "start": 136.2,
      "end": 142.92
    },
    {
      "id": "p11-b01",
      "text": "把四种方案放一起对比，滑动窗口是最便宜的。",
      "start": 143.2,
      "end": 147.653
    },
    {
      "id": "p11-b02",
      "text": "纯滑动窗口降一百二十八倍，混合方案降六倍。",
      "start": 147.9,
      "end": 152.418
    },
    {
      "id": "p11-b03",
      "text": "差分注意力反而要付两倍的缓存，换来无汇的检索。",
      "start": 152.7,
      "end": 157.462
    },
    {
      "id": "p12-b01",
      "text": "如果你要做一个超长文档检索的产品，你会选哪种注意力？",
      "start": 157.7,
      "end": 162.492
    },
    {
      "id": "p12-b02",
      "text": "评论区说说：纯滑动窗口、混合，还是差分。",
      "start": 162.7,
      "end": 167.387
    },
    {
      "id": "p12-b03",
      "text": "关注这个系列，下一集讲投机解码。",
      "start": 167.7,
      "end": 171.286
    }
  ]
}