    {
      "id": "p04",
      "title": "滑动窗口",
      "illustration": "swa",
      "beats": [
        {
          "id": "p04-b01",
          "text": "第一种变体：每个词只看前面固定窗口内的词。"
        },
        {
          "id": "p04-b02",
          "text": "窗口外的位置直接是负无穷，不参与计算。"
        },
        {
          "id": "p04-b03",
          "text": "序列八千、窗口一千零二十四，非零行少了八倍。"
        }
      ],
      "visual_groups": [
        {
          "start_beat": 0,
          "end_beat": 2,
