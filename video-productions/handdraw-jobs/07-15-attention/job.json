    {
      "id": "p06",
      "title": "纯滑窗的短板",
      "illustration": "hybrid",
      "beats": [
        {
          "id": "p06-b01",
          "text": "问题是，纯滑动窗口在长距离检索上会很吃力。"
        },
        {
          "id": "p06-b02",
          "text": "它看不到很远的上下文，信息只能靠层层重叠往前传。"
        },
        {
          "id": "p06-b03",
          "text": "所以实际模型用混合结构。"
        }
      ],
      "visual_groups": [
