{
  "version": 1,
  "source_sha256": "aaf34edf163c6400245b611bc7201d576604260b74cc16c6961a66300d83b782",
  "script_sha256": "51a6ac2e6cd9ca455be2e31274494eae7ae912fa4a9463325273deab7fe65b8a",
  "beats": [
    {
      "id": "p01-b01",
      "text": "Sora、Stable Diffusion 3、Flux。",
      "start": 0.0,
      "end": 3.22
    },
    {
      "id": "p01-b02",
      "text": "这三个模型，都不是用经典扩散做的。",
      "start": 3.36,
      "end": 6.72
    },
    {
      "id": "p01-b03",
      "text": "它们用的是流匹配，采样快四到十倍。",
      "start": 6.96,
      "end": 10.395
    },
    {
      "id": "p02-b01",
      "text": "阶段 8，第 1 课：生成模型的分类与历史。",
      "start": 10.64,
      "end": 14.69
    },
    {
      "id": "p02-b02",
      "text": "过去十二年活下来的生成模型，一共五个家族。",
      "start": 14.96,
      "end": 19.128
    },
    {
      "id": "p02-b03",
      "text": "选错家族，你会跟数学搏斗好几周。",
      "start": 19.36,
      "end": 22.777
    },
    {
      "id": "p03-b01",
      "text": "所有生成模型只干一件事：学着采样出一个分布。",
      "start": 23.04,
      "end": 27.676
    },
    {
      "id": "p03-b02",
      "text": "难题是那个分布住在几百万维的空间里。",
      "start": 27.92,
      "end": 31.76
    },
    {
      "id": "p03-b03",
      "text": "一张五百一十二的彩色图，就是七十八万维。",
      "start": 32.0,
      "end": 35.808
    },
    {
      "id": "p04-b01",
      "text": "第一桶把概率写得出来、算得出来。",
      "start": 36.08,
      "end": 39.2
    },
    {
      "id": "p04-b02",
      "text": "自回归模型把联合分布拆成一串条件概率的乘积。",
      "start": 39.44,
      "end": 44.316
    },
    {
      "id": "p04-b03",
      "text": "GPT、WaveNet、PixelCNN 都属于这一桶。",
      "start": 44.56,
      "end": 48.922
    },
    {
      "id": "p05-b01",
      "text": "第二桶算不出精确概率，只能算一个下界。",
      "start": 49.12,
      "end": 52.885
    },
    {
      "id": "p05-b02",
      "text": "变分自编码器用一个编码器加解码器逼近它。",
      "start": 53.12,
      "end": 57.44
    },
    {
      "id": "p05-b03",
      "text": "扩散模型训练一个去噪器，本质上也在优化同一个下界。",
      "start": 57.68,
      "end": 62.96
    },
    {
      "id": "p06-b01",
      "text": "第三桶干脆绕开概率，只学一个生成器。",
      "start": 63.2,
      "end": 67.025
    },
    {
      "id": "p06-b02",
      "text": "生成器造假，判别器辨真，这就是 GAN。",
      "start": 67.28,
      "end": 71.069
    },
    {
      "id": "p06-b03",
      "text": "推理只要一次前向，但训练极其不稳定。",
      "start": 71.36,
      "end": 75.035
    },
    {
      "id": "p07-b01",
      "text": "第四桶不学密度，学密度的梯度，也就是分数。",
      "start": 75.28,
      "end": 79.587
    },
    {
      "id": "p07-b02",
      "text": "二零二三年流匹配把这个思路改成了直线路径。",
      "start": 79.84,
      "end": 84.324
    },
    {
      "id": "p07-b03",
      "text": "不用仿真、路径更直、采样更快，这是现在的当红选手。",
      "start": 84.56,
      "end": 90.046
    },
    {
      "id": "p08-b01",
      "text": "第五桶先用量化器把图像压成一小串离散 token。",
      "start": 90.32,
      "end": 94.911
    },
    {
      "id": "p08-b02",
      "text": "再拿一个 Transformer 给这串 token 建模。",
      "start": 95.12,
      "end": 98.806
    },
    {
      "id": "p08-b03",
      "text": "Sora 的画面分词、AudioLM 的音频，都是这一路。",
      "start": 98.96,
      "end": 103.652
    },
    {
      "id": "p09-b01",
      "text": "跑一段代码看清第一桶和第三桶的分别。",
      "start": 103.84,
      "end": 107.605
    },
    {
      "id": "p09-b02",
      "text": "直方图和核密度都能回答「这个点出现的概率多大」。",
      "start": 107.84,
      "end": 112.335
    },
    {
      "id": "p09-b03",
      "text": "而 GAN 这一路只吐样本，根本算不出概率。",
      "start": 112.56,
      "end": 116.338
    },
    {
      "id": "p10-b01",
      "text": "二零一三年变分自编码器，第一个能用的深度生成模型。",
      "start": 116.56,
      "end": 121.687
    },
    {
      "id": "p10-b02",
      "text": "二零一四年 GAN，二零二零年扩散变得实用。",
      "start": 121.92,
      "end": 126.088
    },
    {
      "id": "p10-b03",
      "text": "二零二二年潜空间扩散加文本条件，二零二四年流匹配胜出。",
      "start": 126.32,
      "end": 132.31
    },
    {
      "id": "p11-b01",
      "text": "读任何一篇新论文之前，先回答五个问题。",
      "start": 132.56,
      "end": 136.4
    },
    {
      "id": "p11-b02",
      "text": "建的是什么？密度显式还是隐式？采样一次到位还是迭代？",
      "start": 136.64,
      "end": 143.024
    },
    {
      "id": "p11-b03",
      "text": "条件是什么？评测用什么？答完这五个，方法章节就不用猜了。",
      "start": 143.307,
      "end": 149.495
    },
    {
      "id": "p12-b01",
      "text": "Midjourney v7、Runway Gen-3、ElevenLabs，分别属于哪一桶？",
      "start": 149.76,
      "end": 155.262
    },
    {
      "id": "p12-b02",
      "text": "评论区说说你的判断，答错了也没关系。",
      "start": 155.44,
      "end": 159.04
    },
    {
      "id": "p12-b03",
      "text": "关注这个系列，下一集讲变分自编码器。",
      "start": 159.28,
      "end": 162.88
    }
  ]
}