{
  "version": 1,
  "source_sha256": "cfa959f307b8a028ba1d5a55e7a28b9e93528fbe2c049eafc251a301a8c0d33e",
  "script_sha256": "100895b681c4e224e468e44e0d770dea53e8b596dc7d6fa415d9a39c7ab2a534",
  "beats": [
    {
      "id": "p01-b01",
      "text": "一个一万日活的 AI 产品，每月 LLM 账单两万两千美元。",
      "start": 0.0,
      "end": 5.482
    },
    {
      "id": "p01-b02",
      "text": "但其中有四到六成的查询是重复的。",
      "start": 5.72,
      "end": 9.005
    },
    {
      "id": "p01-b03",
      "text": "你在为同一份计算付好几次钱。",
      "start": 9.24,
      "end": 12.194
    },
    {
      "id": "p02-b01",
      "text": "阶段 11，第 11 课：缓存、限流与成本优化。",
      "start": 12.44,
      "end": 17.372
    },
    {
      "id": "p02-b02",
      "text": "大多数 AI 创业公司不是死于糟糕的模型。",
      "start": 17.68,
      "end": 21.76
    },
    {
      "id": "p02-b03",
      "text": "它们死于糟糕的单位经济。",
      "start": 22.0,
      "end": 24.327
    },
    {
      "id": "p03-b01",
      "text": "一次调用有五个成本组成部分。",
      "start": 24.56,
      "end": 27.514
    },
    {
      "id": "p03-b02",
      "text": "system prompt 五百到两千 token，检索上下文五百到四千，用户消息几十到几百。",
      "start": 27.76,
      "end": 35.316
    },
    {
      "id": "p03-b03",
      "text": "前两部分占了大头，而且每个请求都在重复发送。",
      "start": 35.48,
      "end": 40.002
    },
    {
      "id": "p04-b01",
      "text": "假设 system prompt 是一千五百 token。",
      "start": 40.24,
      "end": 43.728
    },
    {
      "id": "p04-b02",
      "text": "一百万次请求，光这个前缀就是 3.75 美元。",
      "start": 43.88,
      "end": 48.3
    },
    {
      "id": "p04-b03",
      "text": "一天十万请求，一个月就是一万一千美元——为一段从不改变的文字。",
      "start": 48.56,
      "end": 54.607
    },
    {
      "id": "p05-b01",
      "text": "三家主流厂商都提供 prompt 缓存，但机制不同。",
      "start": 54.84,
      "end": 59.345
    },
    {
      "id": "p05-b02",
      "text": "Anthropic 是显式标记，命中省九成，但写入要多付两成五。",
      "start": 59.56,
      "end": 65.384
    },
    {
      "id": "p05-b03",
      "text": "OpenAI 是自动前缀匹配，省五成。Gemini 是显式缓存，省七成五。",
      "start": 65.6,
      "end": 72.88
    },
    {
      "id": "p06-b01",
      "text": "Provider 缓存只对完全相同的前缀有效。",
      "start": 73.12,
      "end": 76.853
    },
    {
      "id": "p06-b02",
      "text": "但用户会说「退货政策是什么」和「我怎么退货」。",
      "start": 77.04,
      "end": 80.969
    },
    {
      "id": "p06-b03",
      "text": "把查询变成向量，算余弦相似度，超过 0.95 就直接返回缓存结果。",
      "start": 81.2,
      "end": 87.825
    },
    {
      "id": "p07-b01",
      "text": "对确定性调用，精确缓存更简单也更快。",
      "start": 88.08,
      "end": 92.13
    },
    {
      "id": "p07-b02",
      "text": "把整个 prompt 哈希一遍，查表，命中就返回。",
      "start": 92.4,
      "end": 96.504
    },
    {
      "id": "p07-b03",
      "text": "适合固定 system prompt、相同工具定义、批量处理同一份文档。",
      "start": 96.72,
      "end": 102.604
    },
    {
      "id": "p08-b01",
      "text": "「你们几点关门」用不着一个输出十美元每百万 token 的模型。",
      "start": 102.8,
      "end": 107.846
    },
    {
      "id": "p08-b02",
      "text": "一个复杂度分类器，把简单查询路由给便宜模型。",
      "start": 108.04,
      "end": 112.752
    },
    {
      "id": "p08-b03",
      "text": "实测：65% 的查询可以走 mini，光这一项就省四到七成。",
      "start": 113.0,
      "end": 119.325
    },
    {
      "id": "p09-b01",
      "text": "限流不只是公平，是生存。",
      "start": 119.6,
      "end": 122.336
    },
    {
      "id": "p09-b02",
      "text": "每个用户一个令牌桶，按速率回填，桶空了请求被拒。",
      "start": 122.64,
      "end": 127.821
    },
    {
      "id": "p09-b03",
      "text": "免费版、专业版、企业版三档配额，各自不同。",
      "start": 128.08,
      "end": 132.635
    },
    {
      "id": "p10-b01",
      "text": "没有熔断器，一个 bug 能在几小时内烧穿整月预算。",
      "start": 132.92,
      "end": 137.845
    },
    {
      "id": "p10-b02",
      "text": "预算用到七成，发告警。",
      "start": 138.08,
      "end": 140.569
    },
    {
      "id": "p10-b03",
      "text": "八成就切便宜模型，九成五直接拒绝新请求。",
      "start": 140.88,
      "end": 145.489
    },
    {
      "id": "p11-b01",
      "text": "跑一遍完整流水线对比。",
      "start": 145.76,
      "end": 148.1
    },
    {
      "id": "p11-b02",
      "text": "优化前每千次调用 29 美元，优化后 9.5 美元，省了 67.3%。",
      "start": 148.36,
      "end": 154.972
    },
    {
      "id": "p11-b03",
      "text": "如果叠满七层优化，月账单能从两万二降到五千三。",
      "start": 155.68,
      "end": 160.632
    },
    {
      "id": "p12-b01",
      "text": "你的产品现在用了几层缓存？",
      "start": 160.88,
      "end": 163.63
    },
    {
      "id": "p12-b02",
      "text": "评论区说说：语义缓存、模型路由，还是先加熔断器。",
      "start": 163.88,
      "end": 169.162
    },
    {
      "id": "p12-b03",
      "text": "关注这个系列，下一集讲护栏与内容过滤。",
      "start": 169.44,
      "end": 172.941
    }
  ]
}