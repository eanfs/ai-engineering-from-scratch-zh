			},
			"offsets": {
				"from": 0,
				"to": 5720
			},
			"text": "一个一万日活的 AI 产品,每月 LLM 账单 2 万 2 千美元。"
		},
		{
			"timestamps": {
				"from": "00:00:05,720",
				"to": "00:00:09,240"
			},
			"offsets": {
				"from": 5720,
				"to": 9240
			},
			"text": "但其中有 4 到 6 成的查询是重复的。"
		},
		{
			"timestamps": {
				"from": "00:00:09,240",
				"to": "00:00:12,440"
			},
			"offsets": {
				"from": 9240,
				"to": 12440
			},
			"text": "你再为同一份计算付好几次钱。"
		},
		{
			"timestamps": {
				"from": "00:00:12,440",
				"to": "00:00:17,680"
			},
			"offsets": {
				"from": 12440,
				"to": 17680
			},
			"text": "阶段十一、第十一课、缓存、限流与成本优化。"
		},
		{
			"timestamps": {
				"from": "00:00:17,680",
				"to": "00:00:22,000"
			},
			"offsets": {
				"from": 17680,
				"to": 22000
			},
			"text": "大多数 AI 创业公司不是死于糟糕的模型。"
		},
		{
			"timestamps": {
				"from": "00:00:22,000",
				"to": "00:00:24,560"
			},
			"offsets": {
				"from": 22000,
				"to": 24560
			},
			"text": "他们死于糟糕的单位经济。"
		},
		{
			"timestamps": {
				"from": "00:00:24,560",
				"to": "00:00:27,760"
			},
			"offsets": {
				"from": 24560,
				"to": 27760
			},
			"text": "一次调用有 5 个成本组成部分。"
		},
		{
			"timestamps": {
				"from": "00:00:27,760",
				"to": "00:00:35,480"
			},
			"offsets": {
				"from": 27760,
				"to": 35480
			},
			"text": "System Prompt 500 到 2000 token,检索上下文 500 到 4000,用户消息几十到几百。"
		},
		{
			"timestamps": {
				"from": "00:00:35,480",
				"to": "00:00:40,240"
			},
			"offsets": {
				"from": 35480,
				"to": 40240
			},
			"text": "前两部分占了大头,而且每个请求都在重复发送。"
		},
		{
			"timestamps": {
				"from": "00:00:40,240",
				"to": "00:00:43,880"
			},
			"offsets": {
				"from": 40240,
				"to": 43880
			},
			"text": "假设 System Prompt 是 1500 token。"
		},
		{
			"timestamps": {
				"from": "00:00:43,880",
				"to": "00:00:48,560"
			},
			"offsets": {
				"from": 43880,
				"to": 48560
			},
			"text": "一百万次请求,光这个钱坠,就是 3.75 美元。"
		},
		{
			"timestamps": {
				"from": "00:00:48,560",
				"to": "00:00:54,840"
			},
			"offsets": {
				"from": 48560,
				"to": 54840
			},
			"text": "一天十万请求,一个月就是一万一千美元,为一段从不改变的文字。"
		},
		{
			"timestamps": {
				"from": "00:00:54,840",
				"to": "00:00:59,560"
			},
			"offsets": {
				"from": 54840,
				"to": 59560
			},
			"text": "三家主流厂商都提供 Prompt 缓存,但机制不同。"
		},
		{
			"timestamps": {
				"from": "00:00:59,560",
				"to": "00:01:05,600"
			},
			"offsets": {
				"from": 59560,
				"to": 65600
			},
			"text": "Enthropic 是显示标记,命中省九成,但写入要多付两成五。"
		},
		{
			"timestamps": {
				"from": "00:01:05,600",
				"to": "00:01:09,520"
			},
			"offsets": {
				"from": 65600,
				"to": 69520
			},
			"text": "OpenAI 是自动钱坠匹配,省五成。"
		},
		{
			"timestamps": {
				"from": "00:01:09,520",
				"to": "00:01:13,120"
			},
			"offsets": {
				"from": 69520,
				"to": 73120
			},
			"text": "Gemini 是显示缓存,省七成五。"
		},
		{
			"timestamps": {
				"from": "00:01:13,120",
				"to": "00:01:17,040"
			},
			"offsets": {
				"from": 73120,
				"to": 77040
			},
			"text": "Provider 缓存,只对完全相同的钱坠有效。"
		},
		{
			"timestamps": {
				"from": "00:01:17,040",
				"to": "00:01:21,200"
			},
			"offsets": {
				"from": 77040,
				"to": 81200
			},
			"text": "但用户会说退货政策是什么和我怎么退货。"
		},
		{
			"timestamps": {
				"from": "00:01:21,200",
				"to": "00:01:28,080"
			},
			"offsets": {
				"from": 81200,
				"to": 88080
			},
			"text": "把查询变成像量,算于嫌乡四度,超过 0.95,就直接返回缓存结果。"
		},
		{
			"timestamps": {
				"from": "00:01:28,080",
				"to": "00:01:32,400"
			},
			"offsets": {
				"from": 88080,
				"to": 92400
			},
			"text": "对确定性调用,精确缓存更简单,也更快。"
		},
		{
			"timestamps": {
				"from": "00:01:32,400",
				"to": "00:01:36,720"
			},
			"offsets": {
				"from": 92400,
				"to": 96720
			},
			"text": "把整个 Prompt 哈希一遍,查表,命中就返回。"
		},
		{
			"timestamps": {
				"from": "00:01:36,720",
				"to": "00:01:42,800"
			},
			"offsets": {
				"from": 96720,
				"to": 102800
			},
			"text": "适合固定 System Prompt 相同工具定义,批量处理同一份文档。"
		},
		{
			"timestamps": {
				"from": "00:01:42,800",
				"to": "00:01:48,040"
			},
			"offsets": {
				"from": 102800,
				"to": 108040
			},
			"text": "你们几点关门用不着一个输出十美元每百万 token 的模型。"
		},
		{
			"timestamps": {
				"from": "00:01:48,040",
				"to": "00:01:53,000"
			},
			"offsets": {
				"from": 108040,
				"to": 113000
			},
			"text": "一个复杂度分类器,把简单查询路由给便宜模型。"
		},
		{
			"timestamps": {
				"from": "00:01:53,000",
				"to": "00:01:59,600"
			},
			"offsets": {
				"from": 113000,
				"to": 119600
			},
			"text": "实测,65% 的查询可以走 Mini,光这一项就省四到七成。"
		},
		{
			"timestamps": {
				"from": "00:01:59,600",
				"to": "00:02:02,640"
			},
			"offsets": {
				"from": 119600,
				"to": 122640
			},
			"text": "线流不只是公平,是生存。"
		},
		{
			"timestamps": {
				"from": "00:02:02,640",
				"to": "00:02:08,080"
			},
			"offsets": {
				"from": 122640,
				"to": 128080
			},
			"text": "每个用户一个令牌桶,按速率回填,桶空了,请求备据。"
		},
		{
			"timestamps": {
				"from": "00:02:08,080",
				"to": "00:02:12,920"
			},
			"offsets": {
				"from": 128080,
				"to": 132920
			},
			"text": "免费版、专业版、企业版三档配额,各自不同。"
		},
		{
			"timestamps": {
				"from": "00:02:12,920",
				"to": "00:02:18,080"
			},
			"offsets": {
				"from": 132920,
				"to": 138080
			},
			"text": "没有容断器,一个bug 能在几小时内稍穿整约预算。"
		},
		{
			"timestamps": {
				"from": "00:02:18,080",
				"to": "00:02:20,880"
			},
			"offsets": {
				"from": 138080,
				"to": 140880
			},
			"text": "预算用到七成,发告警。"
		},
		{
			"timestamps": {
				"from": "00:02:20,880",
				"to": "00:02:25,760"
			},
			"offsets": {
				"from": 140880,
				"to": 145760
			},
			"text": "八成就切便宜模型,九成五直接拒绝新请求。"
		},
		{
			"timestamps": {
				"from": "00:02:25,760",
				"to": "00:02:28,360"
			},
			"offsets": {
				"from": 145760,
				"to": 148360
			},
			"text": "跑一遍完整流水线对比。"
		},
		{
			"timestamps": {
				"from": "00:02:28,360",
				"to": "00:02:35,680"
			},
			"offsets": {
				"from": 148360,
				"to": 155680
			},
			"text": "优化前每千次调用二十九美元,优化后九点五美元,省了百分之六十七点三。"
		},
		{
			"timestamps": {
				"from": "00:02:35,680",
				"to": "00:02:40,880"
			},
			"offsets": {
				"from": 155680,
				"to": 160880
			},
			"text": "如果叠满七层优化,月账单能从两万二降到五千三。"
		},
		{
			"timestamps": {
				"from": "00:02:40,880",
				"to": "00:02:43,880"
			},
			"offsets": {
				"from": 160880,
				"to": 163880
			},
			"text": "你的产品现在用了几层缓存。"
		},
		{
			"timestamps": {
				"from": "00:02:43,880",
				"to": "00:02:49,440"
			},
			"offsets": {
				"from": 163880,
				"to": 169440
			},
			"text": "评论区说说,与一缓存,模型路由,还是先加容断器。"
		},
		{
			"timestamps": {
				"from": "00:02:49,440",
				"to": "00:02:53,160"
			},
			"offsets": {
				"from": 169440,
				"to": 173160
			},
			"text": "关注这个系列,下一集讲户篮与内容过滤。"
		}
