{
  "version": 1,
  "source_sha256": "036c10c9b6dd8c19f6d836b5321d61d7f0db46f0eeccd41e70bd42cf31ccbd8d",
  "script_sha256": "721f7e11c59757fbac9bfc5849044a93df49f547134db3100c9e57879500183e",
  "beats": [
    {
      "id": "p01-b01",
      "text": "「给我写一封营销邮件」，这是大多数人写提示词的方式。",
      "start": 0.0,
      "end": 4.773
    },
    {
      "id": "p01-b02",
      "text": "结果是一坨泛泛而谈、根本没法用的东西。",
      "start": 5.0,
      "end": 8.765
    },
    {
      "id": "p01-b03",
      "text": "同一件事，换一种写法，输出天差地别。",
      "start": 9.0,
      "end": 12.733
    },
    {
      "id": "p02-b01",
      "text": "阶段 11，第 1 课：Prompt Engineering，提示词工程。",
      "start": 13.0,
      "end": 17.828
    },
    {
      "id": "p02-b02",
      "text": "它不是花招，也不是绕路的小聪明。",
      "start": 18.0,
      "end": 20.786
    },
    {
      "id": "p02-b03",
      "text": "它是人类意图和机器能力之间最主要的接口。",
      "start": 21.0,
      "end": 25.737
    },
    {
      "id": "p03-b01",
      "text": "每次调用有三个部分：system、user、assistant prefill。",
      "start": 26.0,
      "end": 30.857
    },
    {
      "id": "p03-b02",
      "text": "system 设定身份与规则，跨轮次持续，模型当成最高优先级。",
      "start": 31.0,
      "end": 36.778
    },
    {
      "id": "p03-b03",
      "text": "prefill 可以给回复开头，直接逼出你要的格式。",
      "start": 37.0,
      "end": 41.783
    },
    {
      "id": "p04-b01",
      "text": "「你是一名资深 Python 开发者」不是什么魔咒。",
      "start": 42.0,
      "end": 45.765
    },
    {
      "id": "p04-b02",
      "text": "它是一个激活函数：把采样分布偏向训练数据里专家那一端。",
      "start": 46.0,
      "end": 50.8
    },
    {
      "id": "p04-b03",
      "text": "同样的模型，同样的参数，激活的区域不同，质量就不同。",
      "start": 51.0,
      "end": 55.773
    },
    {
      "id": "p05-b01",
      "text": "「你是个乐于助人的助手」，激活的是泛泛的中位数回答。",
      "start": 56.0,
      "end": 60.773
    },
    {
      "id": "p05-b02",
      "text": "「你是 Stripe 专攻支付的资深后端工程师」，就窄得多、好得多。",
      "start": 61.0,
      "end": 66.769
    },
    {
      "id": "p05-b03",
      "text": "但如果具体到「量子引力弦拓扑全球第一」，只会产出一本正经的胡说。",
      "start": 67.0,
      "end": 72.786
    },
    {
      "id": "p06-b01",
      "text": "模糊版只有一句：给我们新产品写一封营销邮件。",
      "start": 73.0,
      "end": 77.75
    },
    {
      "id": "p06-b02",
      "text": "具体版加了角色、受众、语气、字数、一个具体指标、结尾只留一个 CTA。",
      "start": 78.0,
      "end": 85.714
    },
    {
      "id": "p06-b03",
      "text": "合法输出越少，拿到你想要那个的概率就越高。",
      "start": 86.0,
      "end": 89.789
    },
    {
      "id": "p07-b01",
      "text": "「总结这篇文章」，可能是一段话、五百字长文，或者十个要点。",
      "start": 90.0,
      "end": 95.739
    },
    {
      "id": "p07-b02",
      "text": "「用三个要点总结，每条一句话不超过二十词，只讲定量发现」。",
      "start": 96.0,
      "end": 101.75
    },
    {
      "id": "p07-b03",
      "text": "前者把选择权交给模型，后者把选择权收回来。",
      "start": 102.0,
      "end": 106.737
    },
    {
      "id": "p08-b01",
      "text": "第一种是角色：告诉它你是谁。",
      "start": 107.0,
      "end": 109.75
    },
    {
      "id": "p08-b02",
      "text": "第二种是少样本：给它两三个例子，它照着学。",
      "start": 110.0,
      "end": 113.778
    },
    {
      "id": "p08-b03",
      "text": "第三种是思维链：让它先写推理过程，再给答案。",
      "start": 114.0,
      "end": 118.737
    },
    {
      "id": "p09-b01",
      "text": "护栏模式给模型画一个圈，圈外的问题一律拒绝。",
      "start": 119.0,
      "end": 123.75
    },
    {
      "id": "p09-b02",
      "text": "实测：给一个 Python 助教加上护栏之后，被问别的领域时会明确说不。",
      "start": 124.0,
      "end": 130.741
    },
    {
      "id": "p09-b03",
      "text": "这对面向用户的产品是必需的，不然它会替你做客服以外的一切。",
      "start": 131.0,
      "end": 136.778
    },
    {
      "id": "p10-b01",
      "text": "改了提示词，输出变了，怎么知道是变好还是变坏？",
      "start": 137.0,
      "end": 141.75
    },
    {
      "id": "p10-b02",
      "text": "建一个测试集，每个用例给一份预期输出，跑分。",
      "start": 142.0,
      "end": 146.737
    },
    {
      "id": "p10-b03",
      "text": "实测里同一套用例，gpt-4o 五战全胜，另外两个模型各有所短。",
      "start": 147.0,
      "end": 152.778
    },
    {
      "id": "p11-b01",
      "text": "幻觉：模型编了不存在的事实，通常是约束太少。",
      "start": 153.0,
      "end": 157.737
    },
    {
      "id": "p11-b02",
      "text": "拒答：明明能答却拒绝，通常是护栏写得太宽。",
      "start": 158.0,
      "end": 162.722
    },
    {
      "id": "p11-b03",
      "text": "格式违规：让它输出 JSON，它偏加上一句解释。",
      "start": 163.0,
      "end": 167.75
    },
    {
      "id": "p12-b01",
      "text": "你写提示词时，最常漏掉哪一部分？",
      "start": 168.0,
      "end": 171.714
    },
    {
      "id": "p12-b02",
      "text": "评论区说说：角色、示例，还是输出格式。",
      "start": 172.0,
      "end": 175.733
    },
    {
      "id": "p12-b03",
      "text": "关注这个系列，下一集讲少样本与思维链。",
      "start": 176.0,
      "end": 180.706
    }
  ]
}