      "id": "p03",
      "title": "为什么管用",
      "illustration": "activation",
      "beats": [
        {
          "id": "p03-b01",
          "text": "每次调用有三个部分：system、user、assistant prefill。"
        },
        {
          "id": "p03-b02",
          "text": "system 设定身份与规则，跨轮次持续，模型当成最高优先级。"
        },
        {
          "id": "p03-b03",
          "text": "prefill 可以给回复开头，直接逼出你要的格式。"
        }
      ],
      "visual_groups": [
        {
