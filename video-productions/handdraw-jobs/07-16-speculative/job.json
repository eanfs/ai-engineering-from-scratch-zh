    {
      "id": "p05",
      "title": "接受规则",
      "illustration": "accept-rule",
      "beats": [
        {
          "id": "p05-b01",
          "text": "接受规则是：以两者概率之比的较小值为准。"
        },
        {
          "id": "p05-b02",
          "text": "大模型概率高就全接受，草稿概率高就按比例打折。"
        },
        {
          "id": "p05-b03",
          "text": "一旦拒绝，后面的草稿全部丢弃。"
        }
      ],
      "visual_groups": [
        {
          "start_beat": 0,
