    {
      "id": "p04",
      "title": "三步",
      "illustration": "three-steps",
      "beats": [
        {
          "id": "p04-b01",
          "text": "第一步，草稿模型自回归地提议五个词，带上各自的概率。"
        },
        {
          "id": "p04-b02",
          "text": "第二步，大模型对整段序列跑一次前向，得到自己的概率。"
        },
        {
          "id": "p04-b03",
          "text": "第三步，从左到右逐个判断接受还是拒绝。"
        }
      ],
      "visual_groups": [
        {
          "start_beat": 0,
          "end_beat": 2,
