    {
      "id": "p03",
      "title": "算一笔账",
      "illustration": "math",
      "beats": [
        {
          "id": "p03-b01",
          "text": "七十亿模型在 H100 上采样一个词，大约三十毫秒。"
        },
        {
          "id": "p03-b02",
          "text": "三十亿的草稿模型只要三毫秒。"
        },
        {
          "id": "p03-b03",
          "text": "让草稿模型起草五个词，大模型一次验证，总共四十五毫秒，比直出的一百五十毫秒快三倍。"
        }
      ],
      "visual_groups": [
        {
          "start_beat": 0,
          "end_beat": 2,
          "lead": 0.54,
          "hold": 0.72,
          "actions": [
