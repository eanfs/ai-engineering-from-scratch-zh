{
  "version": 1,
  "source_sha256": "cbb1595e0a46baec3c20b27ebd18f3c33fd4fd09ec007e6ac0e66efe75001bdf",
  "script_sha256": "0feca86aba5db8c7ac4daa17b70248e5292b806651e281ac2817ef794ec7e978",
  "beats": [
    {
      "id": "p01-b01",
      "text": "大模型生成一个词，要跑一次完整的正向传播。",
      "start": 0.0,
      "end": 4.263
    },
    {
      "id": "p01-b02",
      "text": "如果能一次前向就出五个词，速度就快五倍。",
      "start": 4.5,
      "end": 8.561
    },
    {
      "id": "p01-b03",
      "text": "投机解码做的就是这件事。",
      "start": 8.8,
      "end": 11.436
    },
    {
      "id": "p02-b01",
      "text": "阶段 7，第 16 课：投机解码。",
      "start": 11.7,
      "end": 14.973
    },
    {
      "id": "p02-b02",
      "text": "自回归解码是串行的，每个词都等着上一个。",
      "start": 15.3,
      "end": 19.361
    },
    {
      "id": "p02-b03",
      "text": "投机解码打断这条链子。",
      "start": 19.6,
      "end": 22.12
    },
    {
      "id": "p03-b01",
      "text": "七十亿模型在 H100 上采样一个词，大约三十毫秒。",
      "start": 22.4,
      "end": 27.364
    },
    {
      "id": "p03-b02",
      "text": "三十亿的草稿模型只要三毫秒。",
      "start": 27.6,
      "end": 30.646
    },
    {
      "id": "p03-b03",
      "text": "让草稿模型起草五个词，大模型一次验证，总共四十五毫秒，比直出的一百五十毫秒快三倍。",
      "start": 30.9,
      "end": 39.242
    },
    {
      "id": "p04-b01",
      "text": "第一步，草稿模型自回归地提议五个词，带上各自的概率。",
      "start": 39.5,
      "end": 44.761
    },
    {
      "id": "p04-b02",
      "text": "第二步，大模型对整段序列跑一次前向，得到自己的概率。",
      "start": 45.0,
      "end": 50.452
    },
    {
      "id": "p04-b03",
      "text": "第三步，从左到右逐个判断接受还是拒绝。",
      "start": 50.7,
      "end": 54.747
    },
    {
      "id": "p05-b01",
      "text": "接受规则是：以两者概率之比的较小值为准。",
      "start": 55.0,
      "end": 59.25
    },
    {
      "id": "p05-b02",
      "text": "大模型概率高就全接受，草稿概率高就按比例打折。",
      "start": 59.5,
      "end": 64.833
    },
    {
      "id": "p05-b03",
      "text": "一旦拒绝，后面的草稿全部丢弃。",
      "start": 65.1,
      "end": 68.331
    },
    {
      "id": "p06-b01",
      "text": "被拒绝的位置不是丢掉重来，而是从残差分布里重新采样。",
      "start": 68.6,
      "end": 74.062
    },
    {
      "id": "p06-b02",
      "text": "残差就是大模型概率减去草稿概率，只保留正的部分。",
      "start": 74.3,
      "end": 79.455
    },
    {
      "id": "p06-b03",
      "text": "这一步保证了输出分布和大模型自己生成完全一致。",
      "start": 79.7,
      "end": 84.377
    },
    {
      "id": "p07-b01",
      "text": "跑五万个样本验证一下。",
      "start": 84.6,
      "end": 86.76
    },
    {
      "id": "p07-b02",
      "text": "投机解码的计数和直接采样几乎完全一样。",
      "start": 87.0,
      "end": 91.061
    },
    {
      "id": "p07-b03",
      "text": "卡方统计量只有 4.64，自由度是 7，说明分布一致，没有质量损失。",
      "start": 91.3,
      "end": 98.041
    },
    {
      "id": "p08-b01",
      "text": "加速多少，取决于草稿和验证器有多像。",
      "start": 98.3,
      "end": 102.144
    },
    {
      "id": "p08-b02",
      "text": "实测：KL 散度 0.002 时接受率 0.98。",
      "start": 102.4,
      "end": 107.294
    },
    {
      "id": "p08-b03",
      "text": "KL 涨到 5.9，接受率掉到 0.48，几乎白干。",
      "start": 107.6,
      "end": 112.511
    },
    {
      "id": "p09-b01",
      "text": "算一下每次验证平均能产出多少词。",
      "start": 112.8,
      "end": 116.253
    },
    {
      "id": "p09-b02",
      "text": "接受率 0.5 时，验证五次也只能出两个词。",
      "start": 116.5,
      "end": 120.829
    },
    {
      "id": "p09-b03",
      "text": "接受率 0.85 时，五次能出 4.15 个词，快了四倍。",
      "start": 121.1,
      "end": 126.135
    },
    {
      "id": "p10-b01",
      "text": "最朴素的是独立草稿模型，同族效果最好。",
      "start": 126.4,
      "end": 130.541
    },
    {
      "id": "p10-b02",
      "text": "Medusa 在验证器上加多个预测头，不需要第二个模型。",
      "start": 130.8,
      "end": 135.696
    },
    {
      "id": "p10-b03",
      "text": "EAGLE 复用验证器的隐藏状态，接受率更高，典型三到四倍。",
      "start": 135.9,
      "end": 141.543
    },
    {
      "id": "p11-b01",
      "text": "代码和结构化输出的接受率最高，因为可预测。",
      "start": 141.8,
      "end": 146.063
    },
    {
      "id": "p11-b02",
      "text": "自由创作的接受率低，因为下一步太发散。",
      "start": 146.3,
      "end": 150.065
    },
    {
      "id": "p11-b03",
      "text": "贪心解码配合贪心草稿效果好，温度采样会拉低接受率。",
      "start": 150.3,
      "end": 156.039
    },
    {
      "id": "p12-b01",
      "text": "如果你的产品要低延迟，你会选独立草稿还是 Medusa？",
      "start": 156.3,
      "end": 161.292
    },
    {
      "id": "p12-b02",
      "text": "评论区说说：省显存还是省延迟。",
      "start": 161.5,
      "end": 165.1
    },
    {
      "id": "p12-b03",
      "text": "关注这个系列，阶段 7 就到这里。",
      "start": 165.4,
      "end": 168.077
    }
  ]
}