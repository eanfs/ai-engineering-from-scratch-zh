    {
      "id": "p02",
      "title": "片头",
      "illustration": "title-kv",
      "beats": [
        {
          "id": "p02-b01",
          "text": "阶段 7，第 12 课：KV 缓存与 Flash Attention。"
        },
        {
          "id": "p02-b02",
          "text": "训练是并行的、受算力约束；推理是串行的、受显存约束。"
        },
        {
          "id": "p02-b03",
          "text": "瓶颈不同，招数也不同。"
        }
      ],
      "visual_groups": [
        {
          "start_beat": 0,
          "end_beat": 2,
          "lead": 0.54,
          "hold": 0.72,
          "actions": [
