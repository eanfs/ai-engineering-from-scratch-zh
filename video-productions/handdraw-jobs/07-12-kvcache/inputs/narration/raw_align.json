	"transcription": [
		{
			"timestamps": {
				"from": "00:00:00,000",
				"to": "00:00:04,640"
			},
			"offsets": {
				"from": 0,
				"to": 4640
			},
			"text": "你问AI一个问题,为什么第一个字要等那么久?"
		},
		{
			"timestamps": {
				"from": "00:00:04,640",
				"to": "00:00:08,280"
			},
			"offsets": {
				"from": 4640,
				"to": 8280
			},
			"text": "而且回答越长,后面每个字反而越快。"
		},
		{
			"timestamps": {
				"from": "00:00:08,280",
				"to": "00:00:11,280"
			},
			"offsets": {
				"from": 8280,
				"to": 11280
			},
			"text": "答案藏在一张不断变长的表里。"
		},
		{
			"timestamps": {
				"from": "00:00:11,280",
				"to": "00:00:16,040"
			},
			"offsets": {
				"from": 11280,
				"to": 16040
			},
			"text": "阶段期,第十二课,KV缓存语,Flash Tension。"
		},
		{
			"timestamps": {
				"from": "00:00:16,040",
				"to": "00:00:22,120"
			},
			"offsets": {
				"from": 16040,
				"to": 22120
			},
			"text": "训练是并行的,受算力约束,推理是串行的,受显存约束。"
		},
		{
			"timestamps": {
				"from": "00:00:22,120",
				"to": "00:00:24,760"
			},
			"offsets": {
				"from": 22120,
				"to": 24760
			},
			"text": "瓶颈不同,招数也不同。"
		},
		{
			"timestamps": {
				"from": "00:00:24,760",
				"to": "00:00:29,560"
			},
			"offsets": {
				"from": 24760,
				"to": 29560
			},
			"text": "最笨的做法,每生成一个词,就把前面全部重算一遍。"
		},
		{
			"timestamps": {
				"from": "00:00:29,560",
				"to": "00:00:33,200"
			},
			"offsets": {
				"from": 29560,
				"to": 33200
			},
			"text": "生成第N个词,要重算N次注意力。"
		},
		{
			"timestamps": {
				"from": "00:00:33,200",
				"to": "00:00:39,000"
			},
			"offsets": {
				"from": 33200,
				"to": 39000
			},
			"text": "4000个词的回复,就是1600万次运算,绝大部分是重复的。"
		},
		{
			"timestamps": {
				"from": "00:00:39,000",
				"to": "00:00:43,720"
			},
			"offsets": {
				"from": 39000,
				"to": 43720
			},
			"text": "但一个词的隐藏状态,一旦算出来,就再也不会变。"
		},
		{
			"timestamps": {
				"from": "00:00:43,720",
				"to": "00:00:49,720"
			},
			"offsets": {
				"from": 43720,
				"to": 49720
			},
			"text": "于是把每个词的K和V存进一张表,新的词只查表,不重算。"
		},
		{
			"timestamps": {
				"from": "00:00:49,720",
				"to": "00:00:54,560"
			},
			"offsets": {
				"from": 49720,
				"to": 54560
			},
			"text": "这就是KV缓存,推理成本从平方降到线性。"
		},
		{
			"timestamps": {
				"from": "00:00:54,560",
				"to": "00:00:58,680"
			},
			"offsets": {
				"from": 54560,
				"to": 58680
			},
			"text": "表不是免费的,它随上下文线性增长。"
		},
		{
			"timestamps": {
				"from": "00:00:58,680",
				"to": "00:01:03,840"
			},
			"offsets": {
				"from": 58680,
				"to": 63840
			},
			"text": "每个Token,每层,每个头,都要存一份K和一份V。"
		},
		{
			"timestamps": {
				"from": "00:01:03,840",
				"to": "00:01:09,000"
			},
			"offsets": {
				"from": 63840,
				"to": 69000
			},
			"text": "上下文越长,P量越大,这张表越快把显存吃光。"
		},
		{
			"timestamps": {
				"from": "00:01:09,000",
				"to": "00:01:13,760"
			},
			"offsets": {
				"from": 69000,
				"to": 73760
			},
			"text": "拿7000亿参数级的模型算一下,FP16精度。"
		},
		{
			"timestamps": {
				"from": "00:01:13,760",
				"to": "00:01:18,640"
			},
			"offsets": {
				"from": 73760,
				"to": 78640
			},
			"text": "32000上下文,光KV缓存就要10.74G。"
		},
		{
			"timestamps": {
				"from": "00:01:18,640",
				"to": "00:01:25,240"
			},
			"offsets": {
				"from": 78640,
				"to": 85240
			},
			"text": "128000上下文,要42.95G,比一张40G的A100还大。"
		},
		{
			"timestamps": {
				"from": "00:01:25,240",
				"to": "00:01:28,640"
			},
			"offsets": {
				"from": 85240,
				"to": 88640
			},
			"text": "所以,现代模型都在压缩这张表。"
		},
		{
			"timestamps": {
				"from": "00:01:28,640",
				"to": "00:01:35,720"
			},
			"offsets": {
				"from": 88640,
				"to": 95720
			},
			"text": "GTA让多个查询头共享一组,KV头,Lama3是64个查询共享8个。"
		},
		{
			"timestamps": {
				"from": "00:01:35,720",
				"to": "00:01:44,160"
			},
			"offsets": {
				"from": 95720,
				"to": 104160
			},
			"text": "MLA压的更狠,DeepSeqV3在128K上下文只要16.37G,是别人的三分之一。"
		},
		{
			"timestamps": {
				"from": "00:01:44,160",
				"to": "00:01:47,360"
			},
			"offsets": {
				"from": 104160,
				"to": 107360
			},
			"text": "第二个瓶颈,不是算力,是班运。"
		},
		{
			"timestamps": {
				"from": "00:01:47,360",
				"to": "00:01:53,440"
			},
			"offsets": {
				"from": 107360,
				"to": 113440
			},
			"text": "标准注意力,要误化一个N*N的分数矩阵,写进显存再读出来。"
		},
		{
			"timestamps": {
				"from": "00:01:53,440",
				"to": "00:01:59,560"
			},
			"offsets": {
				"from": 113440,
				"to": 119560
			},
			"text": "N到2000以上,注意力还没变成算力瓶颈,先变成了显存瓶颈。"
		},
		{
			"timestamps": {
				"from": "00:01:59,560",
				"to": "00:02:05,920"
			},
			"offsets": {
				"from": 119560,
				"to": 125920
			},
			"text": "H100的显存带宽是每秒3TB,片上Slam是每秒30TB。"
		},
		{
			"timestamps": {
				"from": "00:02:05,920",
				"to": "00:02:09,440"
			},
			"offsets": {
				"from": 125920,
				"to": 129440
			},
			"text": "每一次显存往返,都是10倍的减速。"
		},
		{
			"timestamps": {
				"from": "00:02:09,440",
				"to": "00:02:12,720"
			},
			"offsets": {
				"from": 129440,
				"to": 132720
			},
			"text": "所以,关键不是少算,是少班。"
		},
		{
			"timestamps": {
				"from": "00:02:12,720",
				"to": "00:02:17,000"
			},
			"offsets": {
				"from": 132720,
				"to": 137000
			},
			"text": "FlashTension把Q切成小块,逐个搬进Slam。"
		},
		{
			"timestamps": {
				"from": "00:02:17,000",
				"to": "00:02:22,960"
			},
			"offsets": {
				"from": 137000,
				"to": 142960
			},
			"text": "K和V也分块搬进来,在片上算完注意力,只把结果写回。"
		},
		{
			"timestamps": {
				"from": "00:02:22,960",
				"to": "00:02:26,840"
			},
			"offsets": {
				"from": 142960,
				"to": 146840
			},
			"text": "完整的N*N矩阵,永远不会落到显存里。"
		},
		{
			"timestamps": {
				"from": "00:02:26,840",
				"to": "00:02:33,600"
			},
			"offsets": {
				"from": 146840,
				"to": 153600
			},
			"text": "滚动SoftMax,跨跨维护最大值和累加合,保证最终规划是精确的。"
		},
		{
			"timestamps": {
				"from": "00:02:33,600",
				"to": "00:02:40,080"
			},
			"offsets": {
				"from": 153600,
				"to": 160080
			},
			"text": "跑实测,分块大小从1到32,结果和标准SoftMax竹位相同。"
		},
		{
			"timestamps": {
				"from": "00:02:40,080",
				"to": "00:02:46,120"
			},
			"offsets": {
				"from": 160080,
				"to": 166120
			},
			"text": "误差只有2*10的附16次方,是辅典重牌的舍入,不是近4。"
		},
		{
			"timestamps": {
				"from": "00:02:46,120",
				"to": "00:02:52,200"
			},
			"offsets": {
				"from": 166120,
				"to": 172200
			},
			"text": "如果你的显存,只够跑一个32K上下文的70B模型,你会怎么选?"
		},
		{
			"timestamps": {
				"from": "00:02:52,200",
				"to": "00:02:57,160"
			},
			"offsets": {
				"from": 172200,
				"to": 177160
			},
			"text": "评论区说说,压KV缓存,还是砍上下文长度。"
		},
		{
			"timestamps": {
				"from": "00:02:57,160",
				"to": "00:03:00,480"
			},
			"offsets": {
				"from": 177160,
				"to": 180480
			},
			"text": "关注这个系列,下一集讲扩展定律。"
		}
	]
}
