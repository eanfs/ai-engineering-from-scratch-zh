    {
      "id": "p03",
      "title": "三个时代的答案",
      "illustration": "p03",
      "beats": [
        {
          "id": "p03-b01",
          "text": "第一个经典答案来自 2017 年的 Transformer。"
        },
        {
          "id": "p03-b02",
          "text": "把位置对应的正弦和余弦数值加到词向量上，"
        },
        {
          "id": "p03-b03",
          "text": "叫绝对正弦位置编码。"
        },
        {
          "id": "p03-b04",
          "text": "第二个答案是 2021 年提出的 RoPE，它不直接修改输入嵌入，"
        },
        {
          "id": "p03-b05",
          "text": "而是在注意力计算中按位置旋转查询和键向量。"
        },
        {
          "id": "p03-b06",
          "text": "第三个答案是 ALiBi。"
        },
        {
          "id": "p03-b07",
          "text": "它在 2021 年公开，发表于 2022 年。"
        },
        {
          "id": "p03-b08",
          "text": "直接给注意力分数加入随距离增大的线性惩罚。"
        }
      ],
      "visual_groups": [
        {
          "start_beat": 0,
          "end_beat": 7,
          "lead": 0.54,
          "hold": 0.72,
          "actions": [
            {
              "type": "text",
              "text": "三个时代的答案",
              "x": 100,
              "y": 56,
              "size": 42,
              "color": "#2B2F33",
              "weight": 0.45
            },
            {
