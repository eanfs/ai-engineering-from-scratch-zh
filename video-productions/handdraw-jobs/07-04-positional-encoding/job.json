                    ]
                  ]
                }
              ],
              "drawing_plan_id": "ill-p04",
              "stroke_style": "calm"
            }
          ]
        }
      ]
    },
    {
      "id": "p05",
      "title": "正弦的边界",
      "illustration": "p05",
      "beats": [
        {
          "id": "p05-b01",
          "text": "但能计算新位置不等于模型能可靠理解新位置。"
        },
        {
          "id": "p05-b02",
          "text": "正弦公式可以继续往后算，"
        },
        {
          "id": "p05-b03",
          "text": "模型却未必见过这些更长的序列。"
        },
        {
          "id": "p05-b04",
          "text": "超过训练长度后，性能可能下降。"
        },
        {
          "id": "p05-b05",
          "text": "问题是泛化是否可靠，而不是正弦函数突然失效。"
        },
        {
          "id": "p05-b06",
          "text": "原始 Transformer 使用过这种方案。"
        },
        {
          "id": "p05-b07",
          "text": "需要区分的是，经典 BERT 使用的是学习式绝对位置嵌入，"
        },
        {
          "id": "p05-b08",
          "text": "而不是这张固定的正弦表。"
        }
      ],
      "visual_groups": [
        {
          "start_beat": 0,
          "end_beat": 7,
          "lead": 0.54,
          "hold": 0.72,
          "actions": [
            {
              "type": "text",
              "text": "正弦的边界",
              "x": 100,
              "y": 56,
