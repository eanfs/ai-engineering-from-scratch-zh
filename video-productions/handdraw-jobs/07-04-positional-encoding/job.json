    {
      "id": "p04",
      "title": "正弦：给每个维度一个频率",
      "illustration": "p04",
      "beats": [
        {
          "id": "p04-b01",
          "text": "先看正弦方案：预计算一张位置数乘以模型维度的表。"
        },
        {
          "id": "p04-b02",
          "text": "偶数维使用正弦，奇数维使用余弦。"
        },
        {
          "id": "p04-b03",
          "text": "每一对维度对应一种频率。"
        },
        {
          "id": "p04-b04",
          "text": "维度索引越小，变化越快。"
        },
        {
          "id": "p04-b05",
          "text": "索引越大，变化越慢。"
        },
        {
          "id": "p04-b06",
          "text": "像把不同刻度的尺子放在一起。"
        },
        {
          "id": "p04-b07",
          "text": "把某个位置的这一行加到词向量上，"
        },
        {
          "id": "p04-b08",
          "text": "就给内容附上了位置线索。"
        },
        {
          "id": "p04-b09",
          "text": "编码表本身不需要可训练参数，"
        }
      ],
      "visual_groups": [
        {
          "start_beat": 0,
          "end_beat": 8,
          "lead": 0.54,
          "hold": 0.72,
          "actions": [
            {
              "type": "text",
              "text": "正弦：给每个维度一个频率",
              "x": 100,
              "y": 56,
              "size": 42,
              "color": "#2B2F33",
              "weight": 0.45
            },
            {
              "type": "illustration",
              "source": "inputs/p04.png",
              "x": 280,
              "y": 168,
              "width": 720,
              "height": 405,
              "weight": 3,
              "parts": [
                {
                  "id": "body",
                  "polygon": [
                    [
                      0,
