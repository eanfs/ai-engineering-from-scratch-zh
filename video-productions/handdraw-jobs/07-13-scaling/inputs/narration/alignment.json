{
  "version": 1,
  "source_sha256": "9da64d1d6a7ce29da48b61cdc250af8a2d5dc06f3f0690cb3cf025073609b493",
  "script_sha256": "f5a8a3455b89862b46660a91dcfd6f4517bca983b0bd1bc150b635161696ef95",
  "beats": [
    {
      "id": "p01-b01",
      "text": "GPT-3 有一千七百五十亿参数。",
      "start": 0.0,
      "end": 3.153
    },
    {
      "id": "p01-b02",
      "text": "但有篇论文说，它训练不足十倍。",
      "start": 3.44,
      "end": 6.634
    },
    {
      "id": "p01-b03",
      "text": "参数这么多，怎么还会训练不足？",
      "start": 6.88,
      "end": 9.834
    },
    {
      "id": "p02-b01",
      "text": "阶段 7，第 13 课：Scaling Laws，扩展定律。",
      "start": 10.08,
      "end": 14.509
    },
    {
      "id": "p02-b02",
      "text": "2020 年的论文说，模型越大损失越低。",
      "start": 14.72,
      "end": 18.786
    },
    {
      "id": "p02-b03",
      "text": "2022 年的论文说，你训练不足了。",
      "start": 19.04,
      "end": 22.325
    },
    {
      "id": "p03-b01",
      "text": "训练算力大约等于 6 乘参数乘 token。",
      "start": 22.56,
      "end": 26.262
    },
    {
      "id": "p03-b02",
      "text": "同样一笔算力，可以堆参数，也可以堆数据。",
      "start": 26.48,
      "end": 30.395
    },
    {
      "id": "p03-b03",
      "text": "到底怎么分，这件事并不显然。",
      "start": 30.64,
      "end": 33.427
    },
    {
      "id": "p04-b01",
      "text": "Kaplan 等人 2020 年的结论是：把参数往死里推。",
      "start": 33.68,
      "end": 38.51
    },
    {
      "id": "p04-b02",
      "text": "GPT-3 就是按这个思路做的，一千七百五十亿参数。",
      "start": 38.72,
      "end": 43.66
    },
    {
      "id": "p04-b03",
      "text": "它的训练数据只有三千亿 token，每个参数配 1.7 个 token。",
      "start": 43.92,
      "end": 49.417
    },
    {
      "id": "p05-b01",
      "text": "Hoffmann 等人训了一族叫 Chinchilla 的模型。",
      "start": 49.6,
      "end": 53.298
    },
    {
      "id": "p05-b02",
      "text": "他们发现最优比例不是 1.7，而是每个参数 20 个 token。",
      "start": 53.44,
      "end": 58.902
    },
    {
      "id": "p05-b03",
      "text": "按这个标准，GPT-3 训练不足了十倍。",
      "start": 59.12,
      "end": 63.111
    },
    {
      "id": "p06-b01",
      "text": "损失由两部分组成：参数不够，和数据不够。",
      "start": 63.36,
      "end": 67.576
    },
    {
      "id": "p06-b02",
      "text": "把两边的惩罚加起来，再加上一个不可约的下限。",
      "start": 67.84,
      "end": 72.096
    },
    {
      "id": "p06-b03",
      "text": "在固定算力下求最优，就得到参数和数据该怎么分。",
      "start": 72.32,
      "end": 77.12
    },
    {
      "id": "p07-b01",
      "text": "跑一遍算力最优前沿，从十的十八次方到十的二十五次方。",
      "start": 77.36,
      "end": 82.966
    },
    {
      "id": "p07-b02",
      "text": "十的十八次方，最优是 7800 万参数配 21 亿 token，比例 27。",
      "start": 83.2,
      "end": 89.773
    },
    {
      "id": "p07-b03",
      "text": "到十的二十五次方，比例涨到 120，说明采样范围外会漂移。",
      "start": 90.0,
      "end": 95.914
    },
    {
      "id": "p08-b01",
      "text": "结果很直接：Chinchilla 用 700 亿参数，打败了 1750 亿的 GPT-3。",
      "start": 96.16,
      "end": 102.921
    },
    {
      "id": "p08-b02",
      "text": "它的训练数据是 1.4 万亿 token，正好是每参数 20 个。",
      "start": 103.12,
      "end": 108.496
    },
    {
      "id": "p08-b03",
      "text": "而且推理成本只有 GPT-3 的四成。",
      "start": 108.72,
      "end": 112.528
    },
    {
      "id": "p09-b01",
      "text": "但到了 2026 年，前沿模型的训练比例远远超过 20。",
      "start": 112.8,
      "end": 118.003
    },
    {
      "id": "p09-b02",
      "text": "Llama 3 8B 是 15 万亿 token，每参数 1875 个，是 Chinchilla 的 94 倍。",
      "start": 118.24,
      "end": 125.572
    },
    {
      "id": "p09-b03",
      "text": "原因是：训练成本只付一次，推理成本付一辈子。",
      "start": 125.76,
      "end": 130.686
    },
    {
      "id": "p10-b01",
      "text": "算一笔账。十的二十四次方算力下，最优是 425 亿参数。",
      "start": 130.96,
      "end": 137.099
    },
    {
      "id": "p10-b02",
      "text": "如果把参数砍到十分之一、数据加十倍，损失只多 0.059。",
      "start": 137.36,
      "end": 143.493
    },
    {
      "id": "p10-b03",
      "text": "但推理便宜了十倍，这笔买卖非常划算。",
      "start": 143.76,
      "end": 147.525
    },
    {
      "id": "p11-b01",
      "text": "看真实模型的比例：GPT-3 是 1.7，训练不足。",
      "start": 147.76,
      "end": 152.822
    },
    {
      "id": "p11-b02",
      "text": "Chinchilla 是 20，刚好最优。",
      "start": 153.12,
      "end": 155.764
    },
    {
      "id": "p11-b03",
      "text": "Llama 3 8B 是 1875，DeepSeek V3 是 400，都在大幅过训。",
      "start": 155.92,
      "end": 162.352
    },
    {
      "id": "p12-b01",
      "text": "如果这个模型只用于一次比赛、不打算长期服务，你会怎么选比例？",
      "start": 162.56,
      "end": 168.537
    },
    {
      "id": "p12-b02",
      "text": "评论区说说：贴 Chinchilla 还是过训。",
      "start": 168.8,
      "end": 172.296
    },
    {
      "id": "p12-b03",
      "text": "关注这个系列，下一集讲注意力变体。",
      "start": 172.48,
      "end": 175.84
    }
  ]
}