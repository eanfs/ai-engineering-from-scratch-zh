		{
			"timestamps": {
				"from": "00:01:30,000",
				"to": "00:01:36,160"
			},
			"offsets": {
				"from": 90000,
				"to": 96160
			},
			"text": "到10的25次方,比例涨到120,说明采样范围外会飘移"
