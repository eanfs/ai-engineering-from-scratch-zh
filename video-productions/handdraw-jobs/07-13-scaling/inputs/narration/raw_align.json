				"to": "00:01:23,200"
			},
			"offsets": {
				"from": 77360,
				"to": 83200
			},
			"text": "跑一遍算力最优前沿,从10的18次方,到10的25次方"
		},
		{
			"timestamps": {
				"from": "00:01:23,200",
				"to": "00:01:30,000"
			},
			"offsets": {
				"from": 83200,
				"to": 90000
			},
			"text": "10的18次方,最优是7800万参数,配21亿token,比例27"
