[
 {
  "text": "阶段 7，第 8 课：T5 与 BART。",
  "offset": 0.1,
  "duration": 3.6468085
 },
 {
  "text": "编码器负责理解，解码器负责生成。",
  "offset": 3.6968085,
  "duration": 4.2287234
 },
 {
  "text": "把两个拼回去，就有了输入到输出的模型。",
  "offset": 7.9255319,
  "duration": 4.1755319
 },
 {
  "text": "编码器双向读完整段输入，整段只跑一次。",
  "offset": 12.1010638,
  "duration": 4.7739361
 },
 {
  "text": "解码器自回归生成，每一步都对编码器输出做交叉注意力。",
  "offset": 16.875,
  "duration": 6.2765957
 },
 {
  "text": "编码器输出可以缓存，长输入几乎是免费的。",
  "offset": 23.1515958,
  "duration": 4.8138297
 },
 {
  "text": "训练时解码器吃真实的上一词，这叫 teacher forcing。",
  "offset": 27.9654256,
  "duration": 5.199468
 },
 {
  "text": "输出端错位一格，损失和 GPT 完全一样。",
  "offset": 33.1648937,
  "duration": 4.7340425
 },
 {
  "text": "区别只在于，额外条件来自编码器输出。",
  "offset": 37.8989362,
  "duration": 4.5611702
 },
 {
  "text": "T5 把输入里的随机 span 换成哨兵 token。",
  "offset": 42.4601064,
  "duration": 4.2154255
 },
 {
  "text": "平均每段三个词，总共遮住百分之十五。",
  "offset": 46.675532,
  "duration": 4.4547872
 },
 {
  "text": "解码器只输出被破坏的那几段，比重建整句便宜。",
  "offset": 51.1303192,
  "duration": 5.2659574
 },
 {
  "text": "实跑：源句里的 brown 和 stitch in 被换成了 extra_id 哨兵。",
  "offset": 56.3962767,
  "duration": 6.7154255
 },
 {
  "text": "目标只剩下两段被挖掉的内容。",
  "offset": 63.1117022,
  "duration": 3.3776595
 },
 {
  "text": "把源里的词和目标拼回去，能完整还原原句。",
  "offset": 66.4893618,
  "duration": 4.6941489
 },
 {
  "text": "BART 试了五种加噪：掩码、删除、文本填充、句子打乱、文档旋转。",
  "offset": 71.1835108,
  "duration": 7.4468085
 },
 {
  "text": "文本填充加句子打乱，下游分数最好。",
  "offset": 78.6303193,
  "duration": 4.0425532
 },
 {
  "text": "但解码器要重建整句，预训练算力比 T5 更高。",
  "offset": 82.6728725,
  "duration": 5.305851
 },
 {
  "text": "推理和 GPT 一样自回归，贪心和 beam 都能用。",
  "offset": 87.9787236,
  "duration": 4.893617
 },
 {
  "text": "翻译和摘要输出分布窄，beam 宽度四到五最稳。",
  "offset": 92.8723406,
  "duration": 4.8803191
 },
 {
  "text": "聊天没有固定的输入，beam 反而帮不上忙。",
  "offset": 97.7526598,
  "duration": 4.1489361
 },
 {
  "text": "翻译、语音转写、摘要，编码器-解码器仍然合适。",
  "offset": 101.901596,
  "duration": 6.0505319
 },
 {
  "text": "聊天、代码补全、推理，纯解码器已经接管。",
  "offset": 107.9521279,
  "duration": 5.1728723
 },
 {
  "text": "原因是指令微调和 RLHF，都假设有一个解码器。",
  "offset": 113.1250002,
  "duration": 5.8643617
 },
 {
  "text": "T5 把一切任务改成文本进、文本出。",
  "offset": 118.989362,
  "duration": 4.2553191
 },
 {
  "text": "BART 用去噪自编码器重建整句。",
  "offset": 123.2446811,
  "duration": 3.75
 },
 {
  "text": "架构没有输，输的是规模和后训练的主战场。",
  "offset": 126.9946811,
  "duration": 4.7340425
 }
]