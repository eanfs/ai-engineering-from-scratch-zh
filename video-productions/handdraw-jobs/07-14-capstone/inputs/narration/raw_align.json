				"to": "00:01:10,700"
			},
			"offsets": {
				"from": 67200,
				"to": 70700
			},
			"text": "4層、4個頭,維度128。"
		},
		{
			"timestamps": {
				"from": "00:01:10,700",
				"to": "00:01:15,400"
			},
			"offsets": {
				"from": 70700,
				"to": 75400
			},
			"text": "參數量只有81萬,小到能在筆記本上訓練。"
		},
		{
			"timestamps": {
				"from": "00:01:15,400",
