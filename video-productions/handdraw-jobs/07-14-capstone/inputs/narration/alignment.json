{
  "version": 1,
  "source_sha256": "0f3114149d1a62d0fc270b578115494aa746e2931c2e9361e26f979acdefe04b",
  "script_sha256": "5f517a807d8ba542a505d1b033b08041bab90955734cc8ffe4af5dd4f4f13e2b",
  "beats": [
    {
      "id": "p01-b01",
      "text": "你已经学了十三课，但每一课都是拆开讲的。",
      "start": 0.0,
      "end": 3.778
    },
    {
      "id": "p01-b02",
      "text": "如果把它们拼起来，会得到什么？",
      "start": 4.0,
      "end": 6.862
    },
    {
      "id": "p01-b03",
      "text": "一个能在笔记本上十分钟训完、还会写莎士比亚的模型。",
      "start": 7.1,
      "end": 12.083
    },
    {
      "id": "p02-b01",
      "text": "阶段 7，第 14 课：从零构建一个 Transformer。",
      "start": 12.3,
      "end": 16.804
    },
    {
      "id": "p02-b02",
      "text": "这是整个阶段的收官项目，也叫 nanoGPT。",
      "start": 17.0,
      "end": 21.085
    },
    {
      "id": "p02-b03",
      "text": "它不原创，但每个人都该至少写一遍。",
      "start": 21.3,
      "end": 24.66
    },
    {
      "id": "p03-b01",
      "text": "输入是 token，先过词嵌入和位置嵌入。",
      "start": 24.9,
      "end": 28.772
    },
    {
      "id": "p03-b02",
      "text": "然后堆 L 个 block，每个 block 是归一化、注意力、残差、前馈。",
      "start": 29.0,
      "end": 34.874
    },
    {
      "id": "p03-b03",
      "text": "最后接一个和嵌入共享权重的输出头，得到每个词的概率。",
      "start": 35.1,
      "end": 40.371
    },
    {
      "id": "p04-b01",
      "text": "注意力来自第三课，多头拆分来自第十课，因果掩码来自第七课。",
      "start": 40.6,
      "end": 46.711
    },
    {
      "id": "p04-b02",
      "text": "归一化和前馈来自第五课，位置编码来自第四课。",
      "start": 46.956,
      "end": 51.937
    },
    {
      "id": "p04-b03",
      "text": "十三课的内容，在这里全部接上。",
      "start": 52.2,
      "end": 55.338
    },
    {
      "id": "p05-b01",
      "text": "语料是 tinyshakespeare，大约一兆文本。",
      "start": 55.6,
      "end": 59.05
    },
    {
      "id": "p05-b02",
      "text": "字符级分词，去重后只有六十五个字符。",
      "start": 59.2,
      "end": 63.12
    },
    {
      "id": "p05-b03",
      "text": "没有 BPE，没有分词器的一堆麻烦事。",
      "start": 63.4,
      "end": 66.963
    },
    {
      "id": "p06-b01",
      "text": "四层、四个头、维度一百二十八。",
      "start": 67.2,
      "end": 70.35
    },
    {
      "id": "p06-b02",
      "text": "参数量只有八十一万，小到能在笔记本上训练。",
      "start": 70.7,
      "end": 75.139
    },
    {
      "id": "p06-b03",
      "text": "对比一下大模型是一千多亿参数，这个只有它的万分之六。",
      "start": 75.4,
      "end": 80.592
    },
    {
      "id": "p07-b01",
      "text": "取一个长度二百五十六的窗口，随机采样一批。",
      "start": 80.8,
      "end": 85.035
    },
    {
      "id": "p07-b02",
      "text": "前向，错位一格算交叉熵，反向，AdamW 更新。",
      "start": 85.3,
      "end": 90.132
    },
    {
      "id": "p07-b03",
      "text": "梯度裁剪封顶在一，学习率用余弦调度。",
      "start": 90.4,
      "end": 94.431
    },
    {
      "id": "p08-b01",
      "text": "开始的时候，损失是四点二，等于瞎猜。",
      "start": 94.7,
      "end": 98.414
    },
    {
      "id": "p08-b02",
      "text": "训两千步，大约六分钟，损失降到一点五。",
      "start": 98.7,
      "end": 102.9
    },
    {
      "id": "p08-b03",
      "text": "验证损失和训练损失贴得很近，说明没有过拟合。",
      "start": 103.2,
      "end": 107.95
    },
    {
      "id": "p09-b01",
      "text": "训练完之后，给一个提示词，让它接着写。",
      "start": 108.2,
      "end": 112.044
    },
    {
      "id": "p09-b02",
      "text": "输出里有古英语的词、有换行、还有像罗密欧这样的专名。",
      "start": 112.3,
      "end": 117.465
    },
    {
      "id": "p09-b03",
      "text": "它不是莎士比亚，但长得很像莎士比亚。",
      "start": 117.7,
      "end": 121.356
    },
    {
      "id": "p10-b01",
      "text": "第一，换分词器，用 BPE 把词表从六十五扩到五万。",
      "start": 121.6,
      "end": 126.825
    },
    {
      "id": "p10-b02",
      "text": "第二，换更大语料，一百二十五兆参数训一百亿 token，一张 A100 要一天。",
      "start": 127.1,
      "end": 133.874
    },
    {
      "id": "p10-b03",
      "text": "第三，加上 RoPE、KV 缓存和 Flash Attention，把训练好的东西变成能用的推理栈。",
      "start": 134.1,
      "end": 141.705
    },
    {
      "id": "p11-b01",
      "text": "同样是这个架构，换个配置参数量差两个数量级。",
      "start": 141.9,
      "end": 146.365
    },
    {
      "id": "p11-b02",
      "text": "八十一万、两百六十九万、两千一百三十三万、一亿两千四百万。",
      "start": 146.365,
      "end": 152.568
    },
    {
      "id": "p11-b03",
      "text": "代码路径完全一样，只是规模不同。",
      "start": 152.9,
      "end": 156.057
    },
    {
      "id": "p12-b01",
      "text": "如果给你一台笔记本，你最想给这个模型加哪个能力？",
      "start": 156.3,
      "end": 160.882
    },
    {
      "id": "p12-b02",
      "text": "评论区说说：换分词器、加 RoPE，还是上 KV 缓存。",
      "start": 161.1,
      "end": 166.243
    },
    {
      "id": "p12-b03",
      "text": "关注这个系列，下一集讲注意力变体。",
      "start": 166.5,
      "end": 170.047
    }
  ]
}