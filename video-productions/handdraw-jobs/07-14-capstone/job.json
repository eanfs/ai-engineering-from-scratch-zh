    {
      "id": "p03",
      "title": "架构全景",
      "illustration": "architecture",
      "beats": [
        {
          "id": "p03-b01",
          "text": "输入是 token，先过词嵌入和位置嵌入。"
        },
        {
          "id": "p03-b02",
          "text": "然后堆 L 个 block，每个 block 是归一化、注意力、残差、前馈。"
        },
        {
          "id": "p03-b03",
          "text": "最后接一个和嵌入共享权重的输出头，得到每个词的概率。"
        }
      ],
      "visual_groups": [
