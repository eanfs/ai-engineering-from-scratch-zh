				"from": 0,
				"to": 4140
			},
			"text": "在提示词后面加5个字,让我们一步步思考。"
		},
		{
			"timestamps": {
				"from": "00:00:04,140",
				"to": "00:00:08,300"
			},
			"offsets": {
				"from": 4140,
				"to": 8300
			},
			"text": "准确率从78%涨到91%。"
		},
		{
			"timestamps": {
				"from": "00:00:08,300",
				"to": "00:00:13,000"
			},
			"offsets": {
				"from": 8300,
				"to": 13000
			},
			"text": "同一个模型,同样的温度,同样的API成本。"
		},
		{
			"timestamps": {
				"from": "00:00:13,000",
				"to": "00:00:18,540"
			},
			"offsets": {
				"from": 13000,
				"to": 18540
			},
			"text": "阶段十一,第二课,少样本提示,思维链与思维数。"
		},
		{
			"timestamps": {
				"from": "00:00:18,540",
				"to": "00:00:24,440"
			},
			"offsets": {
				"from": 18540,
				"to": 24440
			},
			"text": "告诉模型该做什么,那是提示。教它该怎么想,那是功成。"
		},
		{
			"timestamps": {
				"from": "00:00:24,440",
				"to": "00:00:27,940"
			},
			"offsets": {
				"from": 24440,
				"to": 27940
			},
			"text": "给模型一个任务不给例子,叫零样本。"
		},
		{
			"timestamps": {
				"from": "00:00:27,940",
				"to": "00:00:30,780"
			},
			"offsets": {
				"from": 27940,
				"to": 30780
			},
			"text": "先给几个例子,叫少样本。"
		},
		{
			"timestamps": {
				"from": "00:00:30,780",
				"to": "00:00:34,500"
			},
			"offsets": {
				"from": 30780,
				"to": 34500
			},
			"text": "简单任务上,两者差不到两个百分点。"
		},
		{
			"timestamps": {
				"from": "00:00:34,500",
				"to": "00:00:39,600"
			},
			"offsets": {
				"from": 34500,
				"to": 39600
			},
			"text": "但多不算数和符号推理,少样本能提10到25个点。"
		},
		{
			"timestamps": {
				"from": "00:00:39,600",
				"to": "00:00:43,880"
			},
			"offsets": {
				"from": 39600,
				"to": 43880
			},
			"text": "与其描述输出格式,不如直接展示格式。"
		},
		{
			"timestamps": {
				"from": "00:00:43,880",
				"to": "00:00:47,800"
			},
			"offsets": {
				"from": 43880,
				"to": 47800
			},
			"text": "与其解释推理过程,不如直接演示一点。"
		},
		{
			"timestamps": {
				"from": "00:00:47,800",
				"to": "00:00:53,280"
			},
			"offsets": {
				"from": 47800,
				"to": 53280
			},
			"text": "模型在势力上做模式匹配,比解读抽象指令可靠的多。"
		},
		{
			"timestamps": {
				"from": "00:00:53,280",
				"to": "00:00:56,100"
			},
			"offsets": {
				"from": 53280,
				"to": 56100
			},
			"text": "不是随便挑几个例子就行。"
		},
		{
			"timestamps": {
				"from": "00:00:56,100",
				"to": "00:01:02,560"
			},
			"offsets": {
				"from": 56100,
				"to": 62560
			},
			"text": "三条原则,与意义上离目标输入境,覆盖所有输出类别,难度匹配。"
		},
		{
			"timestamps": {
				"from": "00:01:02,560",
				"to": "00:01:08,140"
			},
			"offsets": {
				"from": 62560,
				"to": 68140
			},
			"text": "最优数量是3到5个,少于3个信号不够,多于5个收益地检。"
		},
		{
			"timestamps": {
				"from": "00:01:08,140",
				"to": "00:01:14,540"
			},
			"offsets": {
				"from": 68140,
				"to": 74540
			},
			"text": "标准提示下,模型要把所有推理压近一次前向传播的隐藏状态里。"
		},
		{
			"timestamps": {
				"from": "00:01:14,540",
				"to": "00:01:18,100"
			},
			"offsets": {
				"from": 74540,
				"to": 78100
			},
			"text": "思维链让它把中间计算写成token。"
		},
		{
			"timestamps": {
				"from": "00:01:18,100",
				"to": "00:01:24,140"
			},
			"offsets": {
				"from": 78100,
				"to": 84140
			},
			"text": "每个推理token都成为下一个token的上下文,等于延展了计算深度。"
		},
		{
			"timestamps": {
				"from": "00:01:24,140",
				"to": "00:01:28,780"
			},
			"offsets": {
				"from": 84140,
				"to": 88780
			},
			"text": "小学数学基准,GSM8K,8500道题。"
		},
		{
			"timestamps": {
				"from": "00:01:28,780",
				"to": "00:01:35,540"
			},
			"offsets": {
				"from": 88780,
				"to": 95540
			},
			"text": "GPT-4O,零样本78,加思维链91,再加少样本95。"
		},
		{
			"timestamps": {
				"from": "00:01:35,540",
				"to": "00:01:43,700"
			},
			"offsets": {
				"from": 95540,
				"to": 103700
			},
			"text": "GPT-5从94到97,再到98,Lama470B,从80到89,再到94。"
		},
		{
			"timestamps": {
				"from": "00:01:43,700",
				"to": "00:01:50,840"
			},
			"offsets": {
				"from": 103700,
				"to": 110840
			},
			"text": "O3、O4、Mini、Deep Seek2E,这类推理模型,内部已经跑过思维链。"
		},
		{
			"timestamps": {
				"from": "00:01:50,840",
				"to": "00:01:54,380"
			},
			"offsets": {
				"from": 110840,
				"to": 114380
			},
			"text": "再给它们家让我们一步步思考是多余的。"
		},
		{
			"timestamps": {
				"from": "00:01:54,380",
				"to": "00:01:58,580"
			},
			"offsets": {
				"from": 114380,
				"to": 118580
			},
			"text": "有时甚至帮到忙,因为它们已经做过这件事了。"
		},
		{
			"timestamps": {
				"from": "00:01:58,580",
				"to": "00:02:02,540"
			},
			"offsets": {
				"from": 118580,
				"to": 122540
			},
			"text": "单条推理路径可能出错,那就采样5条。"
		},
		{
			"timestamps": {
				"from": "00:02:02,540",
				"to": "00:02:06,900"
			},
			"offsets": {
				"from": 122540,
				"to": 126900
			},
			"text": "对最终答案做多数表决,错误会相互抵消。"
		},
		{
			"timestamps": {
				"from": "00:02:06,900",
				"to": "00:02:14,100"
			},
			"offsets": {
				"from": 126900,
				"to": 134100
			},
			"text": "实测5条路径里,4条算出24,1条算出27,最终答案是24。"
		},
		{
			"timestamps": {
				"from": "00:02:14,100",
				"to": "00:02:20,300"
			},
			"offsets": {
				"from": 134100,
				"to": 140300
			},
			"text": "自洽信是采样多条独立路径,思维数是把路径展开成一棵树。"
		},
		{
			"timestamps": {
				"from": "00:02:20,300",
				"to": "00:02:25,460"
			},
			"offsets": {
				"from": 140300,
				"to": 145460
			},
			"text": "每一层生成几个候选想法,评估打分,减掉差的分支。"
		},
		{
			"timestamps": {
				"from": "00:02:25,460",
				"to": "00:02:30,380"
			},
			"offsets": {
				"from": 145460,
				"to": 150380
			},
			"text": "它更像人在草稿纸上涂改,而不是一口气血到底。"
		},
		{
			"timestamps": {
				"from": "00:02:30,380",
				"to": "00:02:34,980"
			},
			"offsets": {
				"from": 150380,
				"to": 154980
			},
			"text": "简单是实回忆,单部分类,思维链是浪费。"
		},
		{
			"timestamps": {
				"from": "00:02:34,980",
				"to": "00:02:39,780"
			},
			"offsets": {
				"from": 154980,
				"to": 159780
			},
			"text": "每次查询会多出50-200个token的推理开销。"
		},
		{
			"timestamps": {
				"from": "00:02:39,780",
				"to": "00:02:44,500"
			},
			"offsets": {
				"from": 159780,
				"to": 164500
			},
			"text": "高吞吐、低复杂度的任务上,那就是白花的成本。"
		},
		{
			"timestamps": {
				"from": "00:02:44,500",
				"to": "00:02:48,300"
			},
			"offsets": {
				"from": 164500,
				"to": 168300
			},
			"text": "你的场景里,加思维链是赚还是亏?"
		},
		{
			"timestamps": {
				"from": "00:02:48,300",
				"to": "00:02:52,820"
			},
			"offsets": {
				"from": 168300,
