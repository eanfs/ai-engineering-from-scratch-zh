{
  "version": 1,
  "source_sha256": "f02ee1017570a165c5326abf61d600b6285200badd2d660a2ea8517ee0c60588",
  "script_sha256": "e78107d69d442f2b2fb45f050bcd30cdac3381359c2c4bc57202d7bd451383b2",
  "beats": [
    {
      "id": "p01-b01",
      "text": "在提示词后面加五个字：让我们一步步思考。",
      "start": 0.0,
      "end": 3.91
    },
    {
      "id": "p01-b02",
      "text": "准确率从百分之七十八涨到百分之九十一。",
      "start": 4.14,
      "end": 7.884
    },
    {
      "id": "p01-b03",
      "text": "同一个模型、同样的温度、同样的 API 成本。",
      "start": 8.3,
      "end": 12.739
    },
    {
      "id": "p02-b01",
      "text": "阶段 11，第 2 课：少样本提示、思维链与思维树。",
      "start": 13.0,
      "end": 18.248
    },
    {
      "id": "p02-b02",
      "text": "告诉模型该做什么，那是提示。",
      "start": 18.54,
      "end": 21.49
    },
    {
      "id": "p02-b03",
      "text": "教它该怎么想，那是工程。",
      "start": 21.758,
      "end": 24.172
    },
    {
      "id": "p03-b01",
      "text": "给模型一个任务不给例子，叫零样本。先给几个例子，叫少样本。",
      "start": 24.44,
      "end": 30.496
    },
    {
      "id": "p03-b02",
      "text": "简单任务上，两者差不到两个百分点。",
      "start": 30.78,
      "end": 34.252
    },
    {
      "id": "p03-b03",
      "text": "但多步算术和符号推理，少样本能提十到二十五个点。",
      "start": 34.5,
      "end": 39.368
    },
    {
      "id": "p04-b01",
      "text": "与其描述输出格式，不如直接展示格式。",
      "start": 39.6,
      "end": 43.613
    },
    {
      "id": "p04-b02",
      "text": "与其解释推理过程，不如直接演示一遍。",
      "start": 43.88,
      "end": 47.555
    },
    {
      "id": "p04-b03",
      "text": "模型在示例上做模式匹配，比解读抽象指令可靠得多。",
      "start": 47.8,
      "end": 53.031
    },
    {
      "id": "p05-b01",
      "text": "不是随便挑几个例子就行。",
      "start": 53.28,
      "end": 55.844
    },
    {
      "id": "p05-b02",
      "text": "三条原则：语义上离目标输入近、覆盖所有输出类别、难度匹配。",
      "start": 56.1,
      "end": 62.312
    },
    {
      "id": "p05-b03",
      "text": "最优数量是三到五个，少于三个信号不够，多于五个收益递减。",
      "start": 62.56,
      "end": 67.917
    },
    {
      "id": "p06-b01",
      "text": "标准提示下，模型要把所有推理压进一次前向传播的隐藏状态里。",
      "start": 68.14,
      "end": 74.303
    },
    {
      "id": "p06-b02",
      "text": "思维链让它把中间计算写成 token。",
      "start": 74.54,
      "end": 77.891
    },
    {
      "id": "p06-b03",
      "text": "每个推理 token 都成为下一个 token 的上下文，等于延展了计算深度。",
      "start": 78.1,
      "end": 83.957
    },
    {
      "id": "p07-b01",
      "text": "小学数学基准 GSM8K，八千五百道题。",
      "start": 84.14,
      "end": 88.507
    },
    {
      "id": "p07-b02",
      "text": "GPT-4o：零样本七十八，加思维链九十一，再加少样本九十五。",
      "start": 88.78,
      "end": 95.246
    },
    {
      "id": "p07-b03",
      "text": "GPT-5 从九十四到九十七再到九十八，Llama 4 70B 从八十到八十九再到九十四。",
      "start": 95.54,
      "end": 103.445
    },
    {
      "id": "p08-b01",
      "text": "o3、o4-mini、DeepSeek R1 这类推理模型，内部已经跑过思维链。",
      "start": 103.7,
      "end": 110.624
    },
    {
      "id": "p08-b02",
      "text": "再给它们加「让我们一步步思考」是多余的。",
      "start": 110.84,
      "end": 114.172
    },
    {
      "id": "p08-b03",
      "text": "有时甚至帮倒忙，因为它们已经做过这件事了。",
      "start": 114.38,
      "end": 118.359
    },
    {
      "id": "p09-b01",
      "text": "单条推理路径可能出错，那就采样五条。",
      "start": 118.58,
      "end": 122.293
    },
    {
      "id": "p09-b02",
      "text": "对最终答案做多数表决，错误会相互抵消。",
      "start": 122.54,
      "end": 126.644
    },
    {
      "id": "p09-b03",
      "text": "实测五条路径里，四条算出 24，一条算出 27，最终答案是 24。",
      "start": 126.9,
      "end": 133.823
    },
    {
      "id": "p10-b01",
      "text": "自洽性是采样多条独立路径，思维树是把路径展开成一棵树。",
      "start": 134.1,
      "end": 140.052
    },
    {
      "id": "p10-b02",
      "text": "每一层生成几个候选想法，评估打分，剪掉差的分支。",
      "start": 140.3,
      "end": 145.214
    },
    {
      "id": "p10-b03",
      "text": "它更像人在草稿纸上涂改，而不是一口气写到底。",
      "start": 145.46,
      "end": 150.134
    },
    {
      "id": "p11-b01",
      "text": "简单事实回忆、单步分类，思维链是浪费。",
      "start": 150.38,
      "end": 154.692
    },
    {
      "id": "p11-b02",
      "text": "每次查询会多出五十到两百个 token 的推理开销。",
      "start": 154.98,
      "end": 159.571
    },
    {
      "id": "p11-b03",
      "text": "高吞吐、低复杂度的任务上，那就是白花的成本。",
      "start": 159.78,
      "end": 164.252
    },
    {
      "id": "p12-b01",
      "text": "你的场景里，加思维链是赚还是亏？",
      "start": 164.5,
      "end": 168.029
    },
    {
      "id": "p12-b02",
      "text": "评论区说说：你在什么任务上试过，效果如何。",
      "start": 168.3,
      "end": 172.569
    },
    {
      "id": "p12-b03",
      "text": "关注这个系列，下一集讲结构化输出。",
      "start": 172.82,
      "end": 176.068
    }
  ]
}