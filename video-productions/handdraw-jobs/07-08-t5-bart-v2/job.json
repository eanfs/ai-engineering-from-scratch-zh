    {
      "id": "p03",
      "title": "为什么需要两半",
      "illustration": "why-two-halves",
      "beats": [
        {
          "id": "p03-b01",
          "text": "纯解码器的 GPT 和纯编码器的 BERT，各自为不同目标精简了架构。"
        },
        {
          "id": "p03-b02",
          "text": "但很多任务天然是输入到输出：翻译、摘要、语音识别、结构化抽取。"
        },
        {
          "id": "p03-b03",
          "text": "对这些任务，编码器-解码器是最干净的契合。"
        }
      ],
      "visual_groups": [
        {
          "start_beat": 0,
          "end_beat": 2,
          "lead": 0.54,
          "hold": 0.72,
          "actions": [
