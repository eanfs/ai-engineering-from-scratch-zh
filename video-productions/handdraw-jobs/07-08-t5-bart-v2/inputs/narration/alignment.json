{
  "version": 1,
  "source_sha256": "e719ab11073217d5a6b5200ddd5d6129cb0c1fea116b9a39c8f7e404b617ef40",
  "script_sha256": "f0a0bdadf66d9e3dcbd4867480330a1ef4d0b5ff0c61c36b13a841008352646a",
  "beats": [
    {
      "id": "p01-b01",
      "text": "翻译、长文摘要、语音转文字，这三件事为什么能共用一套架构？",
      "start": 0.0,
      "end": 5.911
    },
    {
      "id": "p01-b02",
      "text": "因为它们都是输入端到输出端，而模型可以拆成两半。",
      "start": 6.12,
      "end": 11.111
    },
    {
      "id": "p01-b03",
      "text": "一半负责读懂，一半负责生成，这就是编码器-解码器。",
      "start": 11.36,
      "end": 16.538
    },
    {
      "id": "p02-b01",
      "text": "阶段 7，第 8 课：T5 与 BART，编码器-解码器模型。",
      "start": 16.8,
      "end": 22.048
    },
    {
      "id": "p02-b02",
      "text": "编码器负责理解，解码器负责生成。",
      "start": 22.28,
      "end": 25.809
    },
    {
      "id": "p02-b03",
      "text": "两篇论文，定下了现代序列到序列的标准打法。",
      "start": 26.08,
      "end": 30.46
    },
    {
      "id": "p03-b01",
      "text": "纯解码器的 GPT 和纯编码器的 BERT，各自为不同目标精简了架构。",
      "start": 30.96,
      "end": 36.36
    },
    {
      "id": "p03-b02",
      "text": "但很多任务天然是输入到输出：翻译、摘要、语音识别、结构化抽取。",
      "start": 36.56,
      "end": 43.305
    },
    {
      "id": "p03-b03",
      "text": "对这些任务，编码器-解码器是最干净的契合。",
      "start": 43.64,
      "end": 48.211
    },
    {
      "id": "p04-b01",
      "text": "源 token 进编码器，产出每个输入位置的稠密表示。",
      "start": 48.48,
      "end": 53.148
    },
    {
      "id": "p04-b02",
      "text": "解码器每一步都对这同一份表示做交叉注意力，所以编码器只跑一次。",
      "start": 53.36,
      "end": 59.893
    },
    {
      "id": "p04-b03",
      "text": "解码器自回归地跑，训练时在输出端错位一格，损失和 GPT 一样。",
      "start": 60.2,
      "end": 66.015
    },
    {
      "id": "p05-b01",
      "text": "T5 来自 2019 年的论文，把所有任务都重构成文本进、文本出。",
      "start": 66.28,
      "end": 71.72
    },
    {
      "id": "p05-b02",
      "text": "预训练用 span 破坏：随机挑出片段换成哨兵 token，解码器只解出这些片段。",
      "start": 72.12,
      "end": 78.732
    },
    {
      "id": "p05-b03",
      "text": "单一架构、单一词表、单一损失，这就是它的统一。",
      "start": 78.96,
      "end": 83.545
    },
    {
      "id": "p06-b01",
      "text": "跑一遍代码：输入句子里的片段被换成 extra id 零和 extra id 一。",
      "start": 83.8,
      "end": 89.928
    },
    {
      "id": "p06-b02",
      "text": "目标是哨兵前缀加被挖掉的词：brown，还有 stitch in。",
      "start": 90.12,
      "end": 95.096
    },
    {
      "id": "p06-b03",
      "text": "把未破坏的源 token 和还原出的片段拼起来，和原句完全一致。",
      "start": 95.28,
      "end": 100.41
    },
    {
      "id": "p07-b01",
      "text": "BART 的思路是去噪自编码器，它对输入施加噪声再让解码器重建。",
      "start": 100.6,
      "end": 106.147
    },
    {
      "id": "p07-b02",
      "text": "一共五种：掩码、删除、文本填充、句子打乱、文档旋转。",
      "start": 106.36,
      "end": 112.63
    },
    {
      "id": "p07-b03",
      "text": "文本填充加句子打乱组合效果最好，代价是预训练算力比 T5 更高。",
      "start": 112.96,
      "end": 119.092
    },
    {
      "id": "p08-b01",
      "text": "同一句话跑五种噪声，差别一眼能看出来。",
      "start": 119.32,
      "end": 123.108
    },
    {
      "id": "p08-b02",
      "text": "掩码留下占位符，删除是真的删掉，填充只留一个掩码让模型猜长度。",
      "start": 123.36,
      "end": 129.611
    },
    {
      "id": "p08-b03",
      "text": "句子打乱换掉顺序，文档旋转把开头搬到结尾。",
      "start": 129.84,
      "end": 134.463
    },
    {
      "id": "p09-b01",
      "text": "翻译和语音转文本，编码器-解码器仍然是首选，比如 Whisper。",
      "start": 134.72,
      "end": 140.975
    },
    {
      "id": "p09-b02",
      "text": "聊天、代码补全这类没有固定输入的任务，纯解码器更合适。",
      "start": 141.192,
      "end": 146.526
    },
    {
      "id": "p09-b03",
      "text": "摘要和结构化抽取两种都能做，看你对延迟和质量的要求。",
      "start": 146.8,
      "end": 152.436
    },
    {
      "id": "p10-b01",
      "text": "如果你要做一个翻译或摘要产品，你会选 T5，还是直接用大模型？",
      "start": 152.68,
      "end": 158.169
    },
    {
      "id": "p10-b02",
      "text": "把你的理由写在评论区，我会挑几个典型展开讲。",
      "start": 158.4,
      "end": 162.352
    },
    {
      "id": "p10-b03",
      "text": "关注这个系列，下一集讲 Vision Transformer。",
      "start": 162.56,
      "end": 165.796
    }
  ]
}