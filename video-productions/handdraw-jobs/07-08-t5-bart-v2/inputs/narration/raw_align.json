	"transcription": [
		{
			"timestamps": {
				"from": "00:00:00,000",
				"to": "00:00:06,560"
			},
			"offsets": {
				"from": 0,
				"to": 6560
			},
			"text": "翻译,常文摘要,语音转文字,这三件事为什么能共用一套架构?"
		},
		{
			"timestamps": {
				"from": "00:00:06,560",
				"to": "00:00:11,840"
			},
			"offsets": {
				"from": 6560,
				"to": 11840
			},
			"text": "因为他们都是输入端到输出端,而模型可以拆成两半"
		},
		{
			"timestamps": {
				"from": "00:00:11,840",
				"to": "00:00:17,360"
			},
			"offsets": {
				"from": 11840,
				"to": 17360
			},
			"text": "一半负责读懂,一半负责生成,这就是编码器,解码器"
		},
		{
			"timestamps": {
				"from": "00:00:17,360",
				"to": "00:00:23,040"
			},
			"offsets": {
				"from": 17360,
				"to": 23040
			},
			"text": "阶段期,第八课,T5与BART,编码器,解码器模型"
		},
		{
			"timestamps": {
				"from": "00:00:23,040",
				"to": "00:00:27,040"
			},
			"offsets": {
				"from": 23040,
				"to": 27040
			},
			"text": "编码器负责理解,解码器负责生成"
		},
		{
			"timestamps": {
				"from": "00:00:27,040",
				"to": "00:00:31,680"
			},
			"offsets": {
				"from": 27040,
				"to": 31680
			},
			"text": "两篇论文,定下了现代序列到序列的标准打法"
		},
		{
			"timestamps": {
				"from": "00:00:31,680",
				"to": "00:00:38,160"
			},
			"offsets": {
				"from": 31680,
				"to": 38160
			},
			"text": "纯解码器的GPT和纯编码器的BART,各自为不同目标精减了架构"
		},
		{
			"timestamps": {
				"from": "00:00:38,160",
				"to": "00:00:45,360"
			},
			"offsets": {
				"from": 38160,
				"to": 45360
			},
			"text": "但很多任务,天然是输入到输出,翻译,摘要,语音识别,结构化抽取"
		},
		{
			"timestamps": {
				"from": "00:00:45,360",
				"to": "00:00:50,160"
			},
			"offsets": {
				"from": 45360,
				"to": 50160
			},
			"text": "对这些任务,编码器,解码器是最干净的契合"
		},
		{
			"timestamps": {
				"from": "00:00:50,160",
				"to": "00:00:55,360"
			},
			"offsets": {
				"from": 50160,
				"to": 55360
			},
			"text": "原Token进编码器,产出每个输入位置的绸密表示"
		},
		{
			"timestamps": {
				"from": "00:00:55,360",
				"to": "00:00:59,440"
			},
			"offsets": {
				"from": 55360,
				"to": 59440
			},
			"text": "解码器每一步都对这同一份表示做交叉注意力"
		},
		{
			"timestamps": {
				"from": "00:00:59,440",
				"to": "00:01:02,080"
			},
			"offsets": {
				"from": 59440,
				"to": 62080
			},
			"text": "所以编码器只跑一次"
		},
		{
			"timestamps": {
				"from": "00:01:02,080",
				"to": "00:01:08,800"
			},
			"offsets": {
				"from": 62080,
				"to": 68800
			},
			"text": "解码器自回归的跑,训练时再输出端错位一格,损失和GPT一样"
		},
		{
			"timestamps": {
				"from": "00:01:08,800",
				"to": "00:01:15,280"
			},
			"offsets": {
				"from": 68800,
				"to": 75280
			},
			"text": "T5来自2019年的论文,把所有任务都重构成文本进、文本出"
		},
		{
			"timestamps": {
				"from": "00:01:15,280",
				"to": "00:01:20,320"
			},
			"offsets": {
				"from": 75280,
				"to": 80320
			},
			"text": "预训练用STAN破坏,随机挑出片段换成哨兵Token"
		},
		{
			"timestamps": {
				"from": "00:01:20,320",
				"to": "00:01:22,960"
			},
			"offsets": {
				"from": 80320,
				"to": 82960
			},
			"text": "解码器只解出这些片段"
		},
		{
			"timestamps": {
				"from": "00:01:22,960",
				"to": "00:01:28,160"
			},
			"offsets": {
				"from": 82960,
				"to": 88160
			},
			"text": "呆一架构、呆一词表、呆一损失,这就是它的统一"
		},
		{
			"timestamps": {
				"from": "00:01:28,160",
				"to": "00:01:34,880"
			},
			"offsets": {
				"from": 88160,
				"to": 94880
			},
			"text": "跑一遍代码,输入句子里的片段,被换成xtrID,零和xtrID1"
		},
		{
			"timestamps": {
				"from": "00:01:34,880",
				"to": "00:01:40,160"
			},
			"offsets": {
				"from": 94880,
				"to": 100160
			},
			"text": "目标是哨兵前坠加被挖掉的词,Bron还有Stitchin"
		},
		{
			"timestamps": {
				"from": "00:01:40,160",
				"to": "00:01:46,000"
			},
			"offsets": {
				"from": 100160,
				"to": 106000
			},
			"text": "把未破坏的原Token和还原初的片段拼起来和原句完全一致"
		},
		{
			"timestamps": {
				"from": "00:01:46,000",
				"to": "00:01:52,400"
			},
			"offsets": {
				"from": 106000,
				"to": 112400
			},
			"text": "Bart的思路是去造字编码器,他对输入施加造声,再让解码器重建"
		},
		{
			"timestamps": {
				"from": "00:01:52,400",
				"to": "00:01:58,640"
			},
			"offsets": {
				"from": 112400,
				"to": 118640
			},
			"text": "一共五种,研码、删除、文本填充、句子打乱、文档旋转"
		},
		{
			"timestamps": {
				"from": "00:01:58,640",
				"to": "00:02:05,440"
			},
			"offsets": {
				"from": 118640,
				"to": 125440
			},
			"text": "文本填充加句子、打乱组合效果最好,代价事与训练算力比T5更高"
		},
		{
			"timestamps": {
				"from": "00:02:05,440",
				"to": "00:02:09,680"
			},
			"offsets": {
				"from": 125440,
				"to": 129680
			},
			"text": "同一句话跑五种造声,差别一言,能看出来"
		},
		{
			"timestamps": {
				"from": "00:02:09,680",
				"to": "00:02:16,480"
			},
			"offsets": {
				"from": 129680,
				"to": 136480
			},
			"text": "研码留下站位服,删除是真的删掉,填充只留一个研码,让模型猜长度"
		},
		{
			"timestamps": {
				"from": "00:02:16,480",
				"to": "00:02:21,520"
			},
			"offsets": {
				"from": 136480,
				"to": 141520
			},
			"text": "句子打乱换掉顺序,文档旋转,把开头搬到结尾"
		},
		{
			"timestamps": {
				"from": "00:02:21,520",
				"to": "00:02:27,920"
			},
			"offsets": {
				"from": 141520,
				"to": 147920
			},
			"text": "翻译和语音转文本,编码器、解码器仍然是首选,比如Whisper"
		},
		{
			"timestamps": {
				"from": "00:02:27,920",
				"to": "00:02:33,840"
			},
			"offsets": {
				"from": 147920,
				"to": 153840
			},
			"text": "聊天,代码补权,这类没有固定输入的任务,纯解码器更合适"
		},
		{
			"timestamps": {
				"from": "00:02:33,840",
				"to": "00:02:39,440"
			},
			"offsets": {
				"from": 153840,
				"to": 159440
			},
			"text": "摘药和结构化抽取,两种都能做,看你对延迟和质量的要求"
		},
		{
			"timestamps": {
				"from": "00:02:39,440",
				"to": "00:02:45,600"
			},
			"offsets": {
				"from": 159440,
				"to": 165600
			},
			"text": "如果你要做一个翻译或摘药产品,你会选T5,还是直接用大模型"
		},
		{
			"timestamps": {
				"from": "00:02:45,600",
				"to": "00:02:50,080"
			},
			"offsets": {
				"from": 165600,
				"to": 170080
			},
			"text": "把你的理由写在评论区,我会挑几个典型展开奖"
		},
		{
			"timestamps": {
				"from": "00:02:50,080",
				"to": "00:02:53,860"
			},
			"offsets": {
				"from": 170080,
				"to": 173860
			},
			"text": "關注這個系列,下一集講Vision Transformer"
		}
	]
