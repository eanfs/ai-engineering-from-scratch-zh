                    ],
                    [
                      0,
                      1
                    ]
                  ]
                }
              ],
              "drawing_plan_id": "p03",
              "stroke_style": "calm"
            }
          ]
        }
      ]
    },
    {
      "id": "p04",
      "title": "因果掩码",
      "illustration": "p04",
      "beats": [
        {
          "id": "p04-b01",
          "text": "因果掩码是一个上三角矩阵，上三角填的是负无穷。"
        },
        {
          "id": "p04-b02",
          "text": "它在 softmax 之前加到注意力分数上，softmax 之后那些位置就变成零。"
        },
        {
          "id": "p04-b03",
          "text": "于是每个位置只关注自己和更早的位置，一次前向就得到全部的下一个 token 预测。"
        }
      ],
      "visual_groups": [
        {
          "start_beat": 0,
          "end_beat": 2,
          "lead": 0.54,
          "hold": 0.72,
          "actions": [
            {
              "type": "illustration",
              "source": "inputs/p04.png",
              "x": 320,
              "y": 120,
              "width": 1280,
              "height": 720,
              "weight": 3,
              "parts": [
                {
                  "id": "body",
                  "polygon": [
                    [
                      0,
                      0
                    ],
                    [
                      1,
                      0
                    ],
                    [
                      1,
                      1
                    ],
                    [
                      0,
                      1
                    ]
                  ]
                }
              ],
              "drawing_plan_id": "p04",
              "stroke_style": "calm"
            }
          ]
        }
      ]
    },
    {
      "id": "p05",
      "title": "三角形从何而来",
      "illustration": "p05",
      "beats": [
        {
          "id": "p05-b01",
          "text": "把掩码想成前缀平均，就不神秘了。位置 i 取 0 到 i 的均值。"
        },
        {
          "id": "p05-b02",
          "text": "这个均值可以写成一个下三角矩阵乘以序列，对角线上方的零就是因果性。"
        },
        {
          "id": "p05-b03",
          "text": "从均匀平均到学习权重，再到依赖内容的注意力，三角形始终保留着。"
        }
      ],
      "visual_groups": [
        {
          "start_beat": 0,
          "end_beat": 2,
          "lead": 0.54,
          "hold": 0.72,
          "actions": [
