    {
      "id": "p03",
      "title": "语言模型在学什么",
      "illustration": "p03",
      "beats": [
        {
          "id": "p03-b01",
          "text": "语言模型回答一个问题：给定前面的 token，下一个 token 的概率是多少？"
        },
        {
          "id": "p03-b02",
          "text": "在这个信号上训练，就能一次生成一个 token，组成任意文本。"
        },
        {
          "id": "p03-b03",
          "text": "但要并行训练整段序列，每个位置只能依赖更早的位置，否则模型会作弊。"
        }
      ],
      "visual_groups": [
        {
          "start_beat": 0,
          "end_beat": 2,
          "lead": 0.54,
          "hold": 0.72,
          "actions": [
            {
              "type": "illustration",
              "source": "inputs/p03.png",
              "x": 320,
              "y": 120,
              "width": 1280,
              "height": 720,
              "weight": 3,
              "parts": [
